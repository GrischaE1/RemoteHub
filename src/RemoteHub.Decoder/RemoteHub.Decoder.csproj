<Project Sdk="Microsoft.NET.Sdk">

  <!-- RemoteHubDecoder.exe: decodes a device's video (Media Foundation H.264) and clipboard images (WIC) for RemoteHub, in
       a sandbox RemoteHub starts it in (docs/decoder-isolation-design.md). Only the decoders and the protocol: no
       settings, no database, no network, no files. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>RemoteHubDecoder</AssemblyName>
    <RootNamespace>RemoteHub.Decoder</RootNamespace>
    <ApplicationIcon>..\RemoteHub\Assets\app.ico</ApplicationIcon>
    <Product>RemoteHub</Product>
    <Authors>Grischa Ernst</Authors>
    <Company>Grischa Ernst</Company>
    <Copyright>© 2026 Grischa Ernst</Copyright>
    <Version>0.21.0</Version>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\RemoteHub.Agent\Desktop\VideoCodec.cs" Link="VideoCodec.cs" />
    <Compile Include="..\RemoteHub\Services\DeviceImage.cs" Link="DeviceImage.cs" />
    <Compile Include="..\RemoteHub\Remoting\Decoder\DecoderProtocol.cs" Link="DecoderProtocol.cs" />
  </ItemGroup>

</Project>
