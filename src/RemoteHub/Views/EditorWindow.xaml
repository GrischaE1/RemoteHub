<ui:FluentWindow x:Class="RemoteHub.Views.EditorWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:vm="clr-namespace:RemoteHub.ViewModels"
                 Title="{Binding WindowTitle}" Width="960" Height="780" MinWidth="760" MinHeight="520"
                 WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
                 ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica">
    <ui:FluentWindow.Resources>
        <DataTemplate x:Key="OptionRowTemplate" DataType="{x:Type vm:OptionRow}">
            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="320" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                    <TextBlock Text="{Binding Label}" />
                    <TextBlock Text="{Binding Hint}" Style="{StaticResource Caption}" TextWrapping="Wrap" TextTrimming="None"
                               Visibility="{Binding Hint, Converter={StaticResource BoolToVis}}" />
                    <TextBlock Text="{Binding PolicyNote}" Style="{StaticResource Caption}" FontWeight="SemiBold" TextWrapping="Wrap" TextTrimming="None"
                               Visibility="{Binding PolicyNote, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
                <ComboBox Grid.Column="1" ItemsSource="{Binding Choices}" SelectedItem="{Binding Selected}" VerticalAlignment="Center"
                          IsEnabled="{Binding IsEditable}" ToolTip="{Binding PolicyNote}" ToolTipService.ShowOnDisabled="True" />
            </Grid>
        </DataTemplate>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Title="{Binding WindowTitle}" ShowMaximize="False" ShowMinimize="False" />

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="272" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Navigation: one page per group (built in code, depends on what is edited) -->
            <ScrollViewer x:Name="NavScroll" Margin="12,0,6,12" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="Nav" AutomationProperties.Name="Settings pages" />
            </ScrollViewer>

            <ScrollViewer x:Name="PageScroll" Grid.Column="1" VerticalScrollBarVisibility="Auto" Padding="18,0,24,12">
                <StackPanel>
                    <TextBlock x:Name="PageTitle" FontSize="22" FontWeight="SemiBold" Margin="0,2,0,4" />
                    <TextBlock x:Name="PageHint" Style="{StaticResource Caption}" TextWrapping="Wrap" TextTrimming="None" Margin="0,0,0,12" />

                <StackPanel x:Name="PageGeneral" Visibility="Collapsed">
                <!-- General -->
                <StackPanel>
                    <TextBlock Text="Display name" Margin="0,0,0,4" />
                    <ui:TextBox x:Name="NameBox" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                PlaceholderText="{Binding Host, TargetNullValue='e.g. File server'}" Margin="0,0,0,10" />
                    <Grid Visibility="{Binding IsConnection, Converter={StaticResource BoolToVis}}" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="120" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,10,0">
                            <TextBlock Text="Computer name or IP address" Margin="0,0,0,4" />
                            <ui:TextBox x:Name="HostBox" Text="{Binding Host, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="server01.contoso.local" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Port" Margin="0,0,0,4" />
                            <ui:TextBox Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="3389" />
                        </StackPanel>
                    </Grid>
                    <!-- Below a jump host: how it is reached (read-only; the navigation sets it) -->
                    <TextBlock Text="{Binding RouteText}" Style="{StaticResource Caption}" TextWrapping="Wrap" TextTrimming="None" Margin="0,-6,0,10"
                               Visibility="{Binding RouteText, Converter={StaticResource BoolToVis}}" />
                    <TextBlock Text="Notes" Margin="0,0,0,4" />
                    <ui:TextBox Text="{Binding Notes}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="56" PlaceholderText="Optional" />
                </StackPanel>
                </StackPanel>

                <StackPanel x:Name="PageAppearance" Visibility="Collapsed">
                <!-- Appearance -->
                <StackPanel Visibility="{Binding ShowIconPicker, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="Icon" Margin="0,0,0,6" />
                    <ListBox ItemsSource="{Binding IconChoices}" SelectedItem="{Binding SelectedIcon}"
                             Background="Transparent" BorderThickness="0" Padding="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Margin" Value="0,0,4,4" />
                                <Setter Property="Cursor" Value="Hand" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Bd" Width="38" Height="38" CornerRadius="6" BorderThickness="2"
                                                    BorderBrush="Transparent" Background="{DynamicResource SessionHeaderBrush}"
                                                    ToolTip="{Binding Label}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource ChromeStrokeBrush}" />
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource BrandAccentBrush}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <ui:SymbolIcon Symbol="{Binding Symbol, TargetNullValue=Sparkle24}" FontSize="20"
                                                   Visibility="{Binding Symbol, Converter={StaticResource BoolToVis}}" />
                                    <TextBlock Text="Auto" FontSize="11" VerticalAlignment="Center"
                                               Visibility="{Binding Symbol, Converter={StaticResource InvBoolToVis}}" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <ui:Button Content="Custom image…" Icon="{ui:SymbolIcon Image24}" Click="PickIconImage_Click" />
                        <Border Width="34" Height="34" Margin="10,0,0,0" CornerRadius="6" Background="{DynamicResource SessionHeaderBrush}"
                                Visibility="{Binding HasIconImage, Converter={StaticResource BoolToVis}}">
                            <Image Source="{Binding IconImage, Converter={StaticResource Base64Image}}" Width="24" Height="24" />
                        </Border>
                        <ui:Button Content="Remove image" Margin="8,0,0,0" Click="RemoveIconImage_Click"
                                   Visibility="{Binding HasIconImage, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" TextTrimming="None" Margin="0,4,0,12"
                               Text="PNG, ICO or JPG – scaled to 64 px and stored in the settings file. A custom image wins over the icon above." />
                </StackPanel>

                <TextBlock Text="Colour" Margin="0,0,0,6" />
                <ListBox ItemsSource="{Binding ColourChoices}" SelectedItem="{Binding SelectedColour}"
                         Background="Transparent" BorderThickness="0" Padding="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Margin" Value="0,0,6,6" />
                            <Setter Property="Cursor" Value="Hand" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Bd" MinWidth="34" Height="34" CornerRadius="17" BorderThickness="2" Padding="3"
                                                BorderBrush="Transparent" ToolTip="{Binding Label}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource ChromeStrokeBrush}" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <!-- palette colour / inherited colour -->
                                <Ellipse Width="22" Height="22" Fill="{Binding SwatchBrush}"
                                         Visibility="{Binding SwatchBrush, Converter={StaticResource BoolToVis}}" />
                                <!-- inherit: small dot with the inherited colour + label -->
                                <StackPanel Orientation="Horizontal" Margin="6,0" VerticalAlignment="Center"
                                            Visibility="{Binding IsInherit, Converter={StaticResource BoolToVis}}">
                                    <Ellipse Width="10" Height="10" Margin="0,0,5,0" Fill="{Binding Brush}"
                                             Visibility="{Binding Brush, Converter={StaticResource BoolToVis}}" />
                                    <TextBlock Text="Inherit" FontSize="11" VerticalAlignment="Center" />
                                </StackPanel>
                                <!-- none -->
                                <ui:SymbolIcon Symbol="Prohibited24" FontSize="20"
                                               Visibility="{Binding IsNone, Converter={StaticResource BoolToVis}}" />
                                <!-- custom -->
                                <ui:SymbolIcon Symbol="Color24" FontSize="20"
                                               Visibility="{Binding IsCustom, Converter={StaticResource BoolToVis}}" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                    <TextBlock Text="Custom:" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <ui:TextBox Width="130" Text="{Binding CustomColour, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="#1E90FF" />
                    <Ellipse Width="22" Height="22" Margin="10,0,0,0" Fill="{Binding CustomColourBrush}"
                             Visibility="{Binding CustomColourBrush, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
                <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" TextTrimming="None" Margin="0,4,0,0"
                           Text="Colours the icon in the list, the tab and the session frame – e.g. red for production. Folders pass their colour on to everything inside." />
                </StackPanel>

                <StackPanel x:Name="PageCredentials" Visibility="Collapsed">
                <!-- Credentials -->
                <StackPanel Margin="0,0,0,8">
                    <StackPanel Visibility="{Binding CanInherit, Converter={StaticResource BoolToVis}}">
                        <RadioButton GroupName="Cred" Content="Inherit from parent folder" IsChecked="{Binding IsInherit}" Margin="0,0,0,2" />
                        <TextBlock Text="{Binding InheritedCredentialsText}" Style="{StaticResource Caption}" Margin="28,0,0,8" />
                    </StackPanel>
                    <RadioButton GroupName="Cred" Content="Use a saved credential" IsChecked="{Binding IsSaved}" Margin="0,0,0,4"
                                 IsEnabled="{Binding HasSavedOptions}" />
                    <ComboBox Margin="28,0,0,8" ItemsSource="{Binding SavedOptions}" SelectedItem="{Binding SelectedSaved}"
                              Visibility="{Binding IsSaved, Converter={StaticResource BoolToVis}}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock><Run Text="{Binding Name, Mode=OneWay}" /><Run Text="   " /><Run Text="{Binding Display, Mode=OneWay}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" /></TextBlock>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <TextBlock Text="No saved credentials yet – create them via Menu → Saved credentials." Style="{StaticResource Caption}" Margin="28,0,0,8"
                               Visibility="{Binding HasSavedOptions, Converter={StaticResource InvBoolToVis}}" />
                    <RadioButton GroupName="Cred" Content="Enter credentials for this item" IsChecked="{Binding IsCustom}" />
                </StackPanel>
                <Grid Visibility="{Binding IsCustom, Converter={StaticResource BoolToVis}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Margin="0,0,10,10">
                        <TextBlock Text="Username" Margin="0,0,0,4" />
                        <ui:TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="user or DOMAIN\user" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,0,0,10">
                        <TextBlock Text="Domain" Margin="0,0,0,4" />
                        <ui:TextBox Text="{Binding Domain, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="Optional"
                                    IsEnabled="{Binding DomainEditable}" />
                    </StackPanel>
                    <CheckBox Grid.Row="1" Grid.ColumnSpan="2" Margin="0,0,0,10" IsChecked="{Binding LocalAccount}"
                              Content="Local account on the target computer  (.\user)"
                              ToolTip="Signs in with a local account of whichever computer you connect to – useful for one folder of standalone (non-domain) servers." />
                    <StackPanel Grid.Row="2" Grid.ColumnSpan="2">
                        <TextBlock Text="Password" Margin="0,0,0,4" />
                        <ui:PasswordBox x:Name="PasswordInput" PlaceholderText="Leave empty to be asked when connecting" />
                        <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" TextTrimming="None" Margin="0,4,0,0"
                                   Text="Stored encrypted with Windows DPAPI for your user account. If left empty, Windows asks for the password when connecting – credentials of the parent folder are NOT used in this mode." />
                    </StackPanel>
                </Grid>
                </StackPanel>

                <StackPanel x:Name="PageDisplay" Visibility="Collapsed">

                <ItemsControl ItemsSource="{Binding DisplayRows}" ItemTemplate="{StaticResource OptionRowTemplate}" />
                </StackPanel>

                <StackPanel x:Name="PageResources" Visibility="Collapsed">

                <ItemsControl ItemsSource="{Binding ResourceRows}" ItemTemplate="{StaticResource OptionRowTemplate}" />
                </StackPanel>

                <StackPanel x:Name="PageSecurity" Visibility="Collapsed">

                <ItemsControl ItemsSource="{Binding SecurityRows}" ItemTemplate="{StaticResource OptionRowTemplate}" />
                </StackPanel>

                <StackPanel x:Name="PagePs" Visibility="Collapsed">

                <ItemsControl ItemsSource="{Binding PsRows}" ItemTemplate="{StaticResource OptionRowTemplate}" />
                <TextBlock Text="{Binding PsStatusText}" Style="{StaticResource Caption}" TextWrapping="Wrap" TextTrimming="None" Margin="0,2,0,0"
                           Visibility="{Binding PsStatusText, Converter={StaticResource BoolToVis}}" />
                </StackPanel>

                <StackPanel x:Name="PageTools" Visibility="Collapsed">
                <StackPanel>
                    <ItemsControl ItemsSource="{Binding ToolRows}" ItemTemplate="{StaticResource OptionRowTemplate}" />
                </StackPanel>
                </StackPanel>

                <!-- ===== App settings (global settings only) ===== -->
                <StackPanel x:Name="PageApp" Visibility="Collapsed">
                    <TextBlock Text="Theme" Margin="0,0,0,4" />
                    <ComboBox x:Name="ThemeBox" Width="320" HorizontalAlignment="Left" Margin="0,0,0,14" />
                    <TextBlock Text="Session switch keys" Margin="0,0,0,4" />
                    <ComboBox x:Name="SwitchKeysBox" Width="440" HorizontalAlignment="Left" />
                    <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" TextTrimming="None" Margin="0,4,0,14"
                               Text="Switch between open sessions – also inside a session and in full screen (use the left Alt key)." />
                    <TextBlock Text=".rdp files" Margin="0,0,0,4" />
                    <ui:Button x:Name="DefaultAppButton" Content="Use RemoteHub for .rdp files…" Icon="{ui:SymbolIcon Open24}" />
                    <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" TextTrimming="None" Margin="0,4,0,0"
                               Text="Opens Windows Settings → Default apps, where you choose RemoteHub for .rdp files." />
                </StackPanel>

                <StackPanel x:Name="PageUpdates" Visibility="Collapsed">
                    <TextBlock Text="Updates" Style="{StaticResource SectionHeader}" Margin="0,0,0,8" />
                    <TextBlock x:Name="VersionText" Margin="0,0,0,10" />
                    <ui:ToggleSwitch x:Name="UpdateCheckToggle" Content="Check for updates when RemoteHub starts" Margin="0,0,0,12" />
                    <TextBlock Text="Update channel" Margin="0,0,0,4" />
                    <RadioButton x:Name="ChannelStable" GroupName="Channel" Content="GA – stable releases" Margin="0,0,0,2" />
                    <RadioButton x:Name="ChannelBeta" GroupName="Channel" Content="Beta – pre-releases, and GA releases when they're newer (newer features, less tested)" />
                    <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" TextTrimming="None" Margin="0,6,0,10"
                               Text="RemoteHub only updates to a higher version. Switching from Beta to GA doesn't go back to an older version – you get the next GA release that is newer than the one installed." />
                    <ui:Button x:Name="CheckNowButton" Content="Check for updates now" Icon="{ui:SymbolIcon ArrowSync24}" />
                    <TextBlock x:Name="UpdatePolicyText" Style="{StaticResource Caption}" TextWrapping="Wrap" TextTrimming="None" Margin="0,8,0,0" Visibility="Collapsed" />

                    <TextBlock Text="Privacy" Style="{StaticResource SectionHeader}" />
                    <ui:ToggleSwitch x:Name="TelemetryToggle" Content="Send anonymous usage data and crash reports" Margin="0,0,0,8" />
                    <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" TextTrimming="None" Margin="0,0,0,10"
                               Text="When on, RemoteHub sends small anonymous messages when it starts, so we know roughly how many installs are in use and how they're used: the RemoteHub version, the update channel, Windows 10 / 11 / Server, the processor type (x64 / arm64), a random install ID created on this PC, how many connections, agents, network shares and folders you have (numbers only), and how long RemoteHub ran last time. If RemoteHub crashed, the next start also sends a crash report: the error type, the error message and the program's call stack – with paths, user, computer and server names, IP addresses and quoted values removed. Nothing about your connections, servers, credentials, user or computer name is sent. Like any web request, the server sees your public IP address. The data is kept for 365 days. Turning it off deletes the install ID, and crashes are no longer reported." />
                    <ui:Button x:Name="PrivacyButton" Content="Open privacy statement" Icon="{ui:SymbolIcon Document24}" />
                    <TextBlock x:Name="TelemetryPolicyText" Style="{StaticResource Caption}" TextWrapping="Wrap" TextTrimming="None" Margin="0,8,0,0" Visibility="Collapsed" />
                </StackPanel>

                <StackPanel x:Name="PageData" Visibility="Collapsed">
                    <TextBlock Text="Startup protection" Style="{StaticResource SectionHeader}" Margin="0,0,0,4" />
                    <TextBlock x:Name="ProtectionText" Style="{StaticResource Caption}" TextWrapping="Wrap" TextTrimming="None" Margin="0,0,0,6" />
                    <ui:Button x:Name="ProtectionButton" Content="Startup protection…" Icon="{ui:SymbolIcon LockClosed24}" />

                    <TextBlock Text="Saved credentials" Style="{StaticResource SectionHeader}" Margin="0,18,0,4" />
                    <TextBlock x:Name="CredentialsText" Style="{StaticResource Caption}" TextWrapping="Wrap" TextTrimming="None" Margin="0,0,0,6" />
                    <ui:Button x:Name="CredentialsButton" Content="Manage saved credentials…" Icon="{ui:SymbolIcon Key24}" />

                    <TextBlock Text="Where settings are stored" Style="{StaticResource SectionHeader}" Margin="0,18,0,4" />
                    <TextBlock x:Name="LocationText" Style="{StaticResource Caption}" TextWrapping="Wrap" TextTrimming="None" Margin="0,0,0,6" />
                    <StackPanel Orientation="Horizontal">
                        <ui:Button x:Name="LocationButton" Content="Change location…" Icon="{ui:SymbolIcon Folder24}" Margin="0,0,8,0"
                                   ToolTip="Closes this window first (unsaved changes here are discarded)" />
                        <ui:Button x:Name="FolderButton" Content="Open settings folder" Icon="{ui:SymbolIcon Open24}" />
                    </StackPanel>

                    <TextBlock x:Name="BackupHeader" Text="Backup" Style="{StaticResource SectionHeader}" Margin="0,18,0,4" />
                    <TextBlock x:Name="BackupText" Style="{StaticResource Caption}" TextWrapping="Wrap" TextTrimming="None" Margin="0,0,0,6"
                               Text="A password-protected file with all folders, connections, credentials and settings – to move to another PC or keep as a copy." />
                    <StackPanel Orientation="Horizontal">
                        <ui:Button x:Name="ExportButton" Content="Export backup…" Icon="{ui:SymbolIcon ArrowExport24}" Margin="0,0,8,0" />
                        <ui:Button x:Name="ImportButton" Content="Import backup…" Icon="{ui:SymbolIcon ArrowImport24}"
                                   ToolTip="Closes this window first (unsaved changes here are discarded)" />
                    </StackPanel>

                    <StackPanel x:Name="EnrollmentSection">
                        <TextBlock Text="RemoteHub Agent enrollment" Style="{StaticResource SectionHeader}" Margin="0,18,0,4" />
                        <TextBlock x:Name="EnrollmentText" Style="{StaticResource Caption}" TextWrapping="Wrap" TextTrimming="None" Margin="0,0,0,6" />
                        <StackPanel Orientation="Horizontal">
                            <ui:Button x:Name="EnrollmentSaveButton" Content="Save enrollment file…" Icon="{ui:SymbolIcon ArrowExport24}" Margin="0,0,8,0" />
                            <ui:Button x:Name="EnrollmentReplaceButton" Content="Replace enrollment secret…" Icon="{ui:SymbolIcon Key24}" Margin="0,0,8,0"
                                       ToolTip="A new secret for new enrollment files; agents already claimed keep working" />
                            <ui:Button x:Name="EnrollmentRevokeButton" Content="Revoke earlier secrets…" Icon="{ui:SymbolIcon Delete24}"
                                       ToolTip="Devices installed with an earlier enrollment file can no longer be claimed" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <StackPanel x:Name="PageLogs" Visibility="Collapsed">
                    <TextBlock Text="Audit log" Style="{StaticResource SectionHeader}" Margin="0,0,0,4" />
                    <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" TextTrimming="None" Margin="0,0,0,6"
                               Text="What happened in RemoteHub on this PC: sessions, changes to connections and settings, copied passwords, file transfers, recordings, backups. Never passwords or file contents. Kept in the encrypted database; a hash chain shows if an entry was changed or removed." />
                    <TextBlock Text="Keep entries for" Margin="0,0,0,4" />
                    <ComboBox x:Name="AuditRetentionBox" Width="360" HorizontalAlignment="Left" />
                    <TextBlock x:Name="AuditRetentionText" Style="{StaticResource Caption}" TextWrapping="Wrap" TextTrimming="None" Margin="0,4,0,10" />
                    <ui:Button x:Name="AuditButton" Content="Open audit log…" Icon="{ui:SymbolIcon DocumentBulletList24}" />

                    <TextBlock Text="Script runs" Style="{StaticResource SectionHeader}" Margin="0,18,0,4" />
                    <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" TextTrimming="None" Margin="0,0,0,6"
                               Text="Each run of a script is in the run history. Its output can hold personal data and details of the device: it is kept for the last 10 runs of each script, for at most 30 days, in the encrypted database." />
                    <ui:ToggleSwitch x:Name="KeepRunOutputToggle" Content="Keep the output of runs" />

                    <TextBlock Text="Diagnostic log" Style="{StaticResource SectionHeader}" Margin="0,18,0,4" />
                    <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" TextTrimming="None" Margin="0,0,0,6"
                               Text="For troubleshooting: connection and password-prompt events – no passwords, usernames or host names. A text file on this PC." />
                    <TextBlock x:Name="DiagnosticLogText" Style="{StaticResource Caption}" TextWrapping="Wrap" TextTrimming="None" Margin="0,0,0,6" />
                    <ui:Button x:Name="HelpLogButton" Content="Open diagnostic log" Icon="{ui:SymbolIcon Bug24}" />
                </StackPanel>

                <StackPanel x:Name="PagePolicies" Visibility="Collapsed">
                    <TextBlock x:Name="PolicySummaryText" TextWrapping="Wrap" Margin="0,0,0,6" />
                    <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" TextTrimming="None" Margin="0,0,0,10"
                               Text="Values your organisation set in the registry (Group Policy, Intune or a script). They can't be changed in RemoteHub: the settings they belong to are greyed out. Invalid values are ignored and shown in red." />
                    <StackPanel x:Name="PolicyList" />
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <ui:Button x:Name="PolicyCopyButton" Content="Copy as text" Icon="{ui:SymbolIcon Copy24}" Margin="0,0,8,0" />
                        <ui:Button x:Name="PolicyRefreshButton" Content="Refresh" Icon="{ui:SymbolIcon ArrowSync24}"
                                   ToolTip="Read the policy values again, e.g. after gpupdate" />
                    </StackPanel>
                </StackPanel>

                <StackPanel x:Name="PageRecordings" Visibility="Collapsed">
                    <TextBlock x:Name="RecordingIntroText" Style="{StaticResource Caption}" TextWrapping="Wrap" TextTrimming="None" Margin="0,0,0,4" />

                    <TextBlock Text="Quality" Style="{StaticResource SectionHeader}" Margin="0,14,0,4" />
                    <TextBlock Text="Frame rate" Margin="0,0,0,4" />
                    <ComboBox x:Name="RecordingFpsBox" Width="360" HorizontalAlignment="Left" Margin="0,0,0,10" />
                    <TextBlock Text="Video size" Margin="0,0,0,4" />
                    <ComboBox x:Name="RecordingResolutionBox" Width="360" HorizontalAlignment="Left" />
                    <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" TextTrimming="None" Margin="0,4,0,0"
                               Text="For presentations choose 30 fps and Full HD or 4K – the tab's content (without its header) is scaled to that size. Higher values make larger files and need more CPU; if the PC can't keep up, single frames are skipped. Applies to the next recording." />

                    <TextBlock Text="Graphics card" Style="{StaticResource SectionHeader}" Margin="0,18,0,4" />
                    <ui:ToggleSwitch x:Name="RecordingDetailsToggle" Content="Include the connection details" />
                    <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" TextTrimming="None" Margin="0,4,0,12"
                               Text="On: the video shows the bar above the tab too – which connection, its address and how it connects. Off (default): only what is in the tab." />
                    <ui:ToggleSwitch x:Name="RecordingGpuToggle" Content="Capture with the graphics card (needed for 30 and 60 fps)" />
                    <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" TextTrimming="None" Margin="0,4,0,0"
                               Text="Off (default): works everywhere, also on servers and virtual machines without a graphics card – about 10 fps. On: Full HD reaches 30–60 fps and 4K about 30; where no graphics card can be used, RemoteHub falls back to the default way by itself. Turn it off again if the PC becomes unstable while recording." />

                    <TextBlock Text="Where recordings are saved" Style="{StaticResource SectionHeader}" Margin="0,18,0,4" />
                    <TextBlock x:Name="RecordingInfoText" Style="{StaticResource Caption}" TextWrapping="Wrap" TextTrimming="None" Margin="0,0,0,6" />
                    <StackPanel Orientation="Horizontal">
                        <ui:Button x:Name="RecordingFolderButton" Content="Change folder…" Icon="{ui:SymbolIcon Folder24}" Margin="0,0,8,0" />
                        <ui:Button x:Name="RecordingDefaultButton" Content="Use the default folder" Icon="{ui:SymbolIcon ArrowReset24}" Margin="0,0,8,0" />
                        <ui:Button x:Name="RecordingOpenButton" Content="Open folder" Icon="{ui:SymbolIcon Open24}" />
                    </StackPanel>
                </StackPanel>

                <StackPanel x:Name="PageHelp" Visibility="Collapsed">
                    <TextBlock x:Name="HelpVersionText" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <ui:Button x:Name="AboutButton" Content="About RemoteHub…" Icon="{ui:SymbolIcon Info24}" Margin="0,0,8,0"
                                   ToolTip="Version, build, .NET, Windows, remote desktop client and where the program, settings and log are" />
                        <ui:Button x:Name="OverviewButton" Content="Settings overview…" Icon="{ui:SymbolIcon TextBulletListSquare24}"
                                   ToolTip="Every setting in one place, with Copy as text for support" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,4">
                        <ui:Button x:Name="WhatsNewButton" Content="What's new…" Icon="{ui:SymbolIcon Sparkle24}" Margin="0,0,8,0"
                                   ToolTip="The highlights of this version" />
                        <ui:Button x:Name="WelcomeButton" Content="Welcome tour…" Icon="{ui:SymbolIcon Map24}"
                                   ToolTip="The short introduction shown on the first start" />
                    </StackPanel>

                    <TextBlock Text="License" Style="{StaticResource SectionHeader}" Margin="0,18,0,6" />
                    <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" TextTrimming="None" Margin="0,0,0,10"
                               Text="RemoteHub and the RemoteHub Agent are free software under the GNU Affero General Public License version 3 (AGPL-3.0): you may use, change and share them under its terms. They come without any warranty. The libraries they ship keep their own licenses." />
                    <StackPanel Orientation="Horizontal">
                        <ui:Button x:Name="LicenseButton" Content="Open license" Icon="{ui:SymbolIcon Document24}" Margin="0,0,8,0" />
                        <ui:Button x:Name="NoticesButton" Content="Third-party notices" Icon="{ui:SymbolIcon Document24}" />
                    </StackPanel>
                    <TextBlock x:Name="LicenseErrorText" Style="{StaticResource Caption}" TextWrapping="Wrap" TextTrimming="None" Margin="0,8,0,0" Visibility="Collapsed" />

                    <TextBlock Text="Keyboard shortcuts" Style="{StaticResource SectionHeader}" Margin="0,18,0,6" />
                    <StackPanel>
                        <DockPanel Margin="0,3">
                            <TextBlock Text="Ctrl+N" Width="150" FontFamily="Cascadia Mono, Consolas" VerticalAlignment="Center" />
                            <TextBlock Text="New connection" TextWrapping="Wrap" VerticalAlignment="Center" />
                        </DockPanel>
                        <DockPanel Margin="0,3">
                            <TextBlock Text="Ctrl+Shift+N" Width="150" FontFamily="Cascadia Mono, Consolas" VerticalAlignment="Center" />
                            <TextBlock Text="New folder" TextWrapping="Wrap" VerticalAlignment="Center" />
                        </DockPanel>
                        <DockPanel Margin="0,3">
                            <TextBlock Text="Ctrl+F" Width="150" FontFamily="Cascadia Mono, Consolas" VerticalAlignment="Center" />
                            <TextBlock Text="Search folders and connections, or quick-connect to a computer name" TextWrapping="Wrap" VerticalAlignment="Center" />
                        </DockPanel>
                        <DockPanel Margin="0,3">
                            <TextBlock Text="Ctrl+B" Width="150" FontFamily="Cascadia Mono, Consolas" VerticalAlignment="Center" />
                            <TextBlock Text="Show or hide the navigation" TextWrapping="Wrap" VerticalAlignment="Center" />
                        </DockPanel>
                        <DockPanel Margin="0,3">
                            <TextBlock Text="Ctrl+," Width="150" FontFamily="Cascadia Mono, Consolas" VerticalAlignment="Center" />
                            <TextBlock Text="Settings" TextWrapping="Wrap" VerticalAlignment="Center" />
                        </DockPanel>
                        <DockPanel Margin="0,3">
                            <TextBlock Text="F2" Width="150" FontFamily="Cascadia Mono, Consolas" VerticalAlignment="Center" />
                            <TextBlock Text="Edit the selected folder or connection" TextWrapping="Wrap" VerticalAlignment="Center" />
                        </DockPanel>
                        <DockPanel Margin="0,3">
                            <TextBlock Text="Del" Width="150" FontFamily="Cascadia Mono, Consolas" VerticalAlignment="Center" />
                            <TextBlock Text="Delete the selected folder or connection" TextWrapping="Wrap" VerticalAlignment="Center" />
                        </DockPanel>
                    </StackPanel>
                    <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap" TextTrimming="None" Margin="0,8,0,0"
                               Text="Switching between sessions uses the keys chosen under General." />
                </StackPanel>

                </StackPanel>
            </ScrollViewer>
        </Grid>

        <Border Grid.Row="2" Padding="24,14" Background="{DynamicResource LayerFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <ui:Button Content="Save" Appearance="Primary" IsDefault="True" MinWidth="100" Click="Save_Click" Margin="0,0,8,0" />
                    <ui:Button Content="Cancel" IsCancel="True" MinWidth="100" />
                </StackPanel>
                <TextBlock Text="{Binding Error}" Foreground="#E5484D" VerticalAlignment="Center" TextWrapping="Wrap" />
            </DockPanel>
        </Border>
    </Grid>
</ui:FluentWindow>
