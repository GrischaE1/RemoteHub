<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <AssemblyName>RemoteHub</AssemblyName>
    <RootNamespace>RemoteHub</RootNamespace>
    <Product>RemoteHub</Product>
    <Authors>Grischa Ernst</Authors>
    <Company>Grischa Ernst</Company>
    <Copyright>© 2026 Grischa Ernst</Copyright>
    <Version>0.21.0</Version>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- WPF app: DPI awareness (PerMonitorV2) must come from the manifest -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="WPF-UI" Version="4.3.0" />
    <!-- PowerShell remoting client (WSMan) for the PowerShell tab and file transfer -->
    <PackageReference Include="Microsoft.PowerShell.SDK" Version="7.6.6" />
    <!-- Local database: SQLite with whole-file encryption (SQLite3 Multiple Ciphers, ChaCha20-Poly1305). Only the
         .Core package â€“ the full Microsoft.Data.Sqlite brings an unencrypted SQLite that conflicts with this bundle. -->
    <PackageReference Include="Microsoft.Data.Sqlite.Core" Version="10.0.12" />
    <PackageReference Include="SQLite3MC.PCLRaw.bundle" Version="2.4.0" />
    <!-- Network shares: SFTP, FTP/FTPS, and SMB when Windows' own client can't be used (another account on the same server) -->
    <PackageReference Include="SSH.NET" Version="2026.0.0" />
    <PackageReference Include="FluentFTP" Version="55.1.0" />
    <PackageReference Include="SMBLibrary" Version="1.5.8.1" />
    <!-- Notes: Markdown parsing (the signed build the PowerShell SDK already brings) and the script block editor -->
    <PackageReference Include="Markdig.Signed" Version="0.44.0" />
    <PackageReference Include="AvalonEdit" Version="6.3.1.120" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\app.ico" />
    <!-- Scripts view (docs/scripts-view-design.md): the built-in library and the script that runs a script on a device -->
    <EmbeddedResource Include="Assets\ScriptLibrary\**\*.ps1" LogicalName="ScriptLibrary/%(RecursiveDir)%(Filename)%(Extension)" />
    <EmbeddedResource Include="Assets\Scripts\RunScript.ps1" LogicalName="Scripts/RunScript.ps1" />
    <!-- The elevated update step: embedded for the Windows PowerShell fallback, and next to RemoteHub.exe for RemoteHubUpdate.exe (UpdateService.StartInstall) -->
    <EmbeddedResource Include="Assets\Update\InstallUpdate.ps1" LogicalName="Update/InstallUpdate.ps1" />
    <None Include="Assets\Update\InstallUpdate.ps1" Link="InstallUpdate.ps1" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <!-- RemoteHub's own license (AGPL-3.0) and those of the libraries shipped with it (installed next to RemoteHub.exe) -->
    <None Include="..\..\LICENSE" Link="LICENSE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\..\THIRD-PARTY-NOTICES.md" Link="THIRD-PARTY-NOTICES.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\..\PRIVACY.md" Link="PRIVACY.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- Wire contract shared with the RemoteHub Agent -->
    <Compile Include="..\RemoteHub.Agent\AgentProtocol.cs" Link="Remoting\AgentProtocol.cs" />
    <Compile Include="..\RemoteHub.Agent\AgentEnrollment.cs" Link="Remoting\AgentEnrollment.cs" />
    <Compile Include="..\RemoteHub.Agent\TunnelProtocol.cs" Link="Remoting\TunnelProtocol.cs" />
    <Compile Include="..\RemoteHub.Agent\BrokerProtocol.cs" Link="Remoting\BrokerProtocol.cs" />
    <Compile Include="..\RemoteHub.Agent\BrokerLiveness.cs" Link="Remoting\BrokerLiveness.cs" />
    <Compile Include="..\RemoteHub.Agent\PeerDirect.cs" Link="Remoting\PeerDirect.cs" />
    <Compile Include="..\RemoteHub.Agent\Desktop\DesktopProtocol.cs" Link="Remoting\Desktop\DesktopProtocol.cs" />
    <Compile Include="..\RemoteHub.Agent\Desktop\VideoCodec.cs" Link="Remoting\Desktop\VideoCodec.cs" />
    <Compile Include="..\RemoteHub.Agent\Desktop\ClipboardTransfer.cs" Link="Remoting\Desktop\ClipboardTransfer.cs" />
    <Compile Include="..\RemoteHub.Agent\Desktop\VirtualFiles.cs" Link="Remoting\Desktop\VirtualFiles.cs" />
    <!-- Policy values of both products (Settings → Policies, policy\RemoteHub.admx) -->
    <Compile Include="..\RemoteHub.Agent\PolicyCatalog.cs" Link="Services\PolicyCatalog.cs" />
  </ItemGroup>

  <!-- RemoteHubDecoder.exe decodes a device's video and clipboard images in a sandbox (docs/decoder-isolation-design.md).
       Built with RemoteHub and copied next to RemoteHub.exe; build-installer.ps1 publishes it into the same folder. -->
  <PropertyGroup>
    <ValidateExecutableReferencesMatchSelfContained>false</ValidateExecutableReferencesMatchSelfContained>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\RemoteHub.Decoder\RemoteHub.Decoder.csproj" ReferenceOutputAssembly="false" Private="false" />
  </ItemGroup>
  <Target Name="CopyDecoder" AfterTargets="Build">
    <ItemGroup>
      <DecoderFiles Include="..\RemoteHub.Decoder\bin\$(Configuration)\$(TargetFramework)\$(RuntimeIdentifier)\RemoteHubDecoder.*" />
    </ItemGroup>
    <Copy SourceFiles="@(DecoderFiles)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>

  <ItemGroup>
    <Using Include="System" />
    <Using Include="System.Collections.Generic" />
    <Using Include="System.IO" />
    <Using Include="System.Linq" />
    <Using Include="System.Threading.Tasks" />
  </ItemGroup>

</Project>

