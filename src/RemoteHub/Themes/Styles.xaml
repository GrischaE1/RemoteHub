<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:v="clr-namespace:RemoteHub.Views"
                    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <v:BoolToVisibility x:Key="BoolToVis" />
    <v:BoolToVisibility x:Key="InvBoolToVis" Invert="True" />
    <v:BoolToVisibility x:Key="BoolToVisHidden" UseHidden="True" />
    <v:BoolToVisibility x:Key="InvBoolToVisHidden" Invert="True" UseHidden="True" />
    <v:SessionStateToBrush x:Key="StateBrush" />
    <v:BrushTint x:Key="BrushTint" />
    <v:Base64ImageConverter x:Key="Base64Image" />
    <v:ConcatCollections x:Key="Concat" />
    <v:TransferStateToSymbol x:Key="TransferSymbol" />
    <v:TransferStateToBrush x:Key="TransferBrush" />
    <v:BoolToChevron x:Key="ChevronSymbol" />

    <SolidColorBrush x:Key="OnlineBrush" Color="#3FB950" />

    <!-- App chrome (overwritten per theme by AppChrome.ApplyPalette) -->
    <SolidColorBrush x:Key="ChromeBackgroundBrush" Color="#161B26" />
    <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="#1C2230" />
    <SolidColorBrush x:Key="SessionAreaBrush" Color="#0F131B" />
    <SolidColorBrush x:Key="SessionHeaderBrush" Color="#232A3A" />
    <SolidColorBrush x:Key="ChromeStrokeBrush" Color="#2E3850" />
    <SolidColorBrush x:Key="BrandAccentBrush" Color="#0078D4" />
    <SolidColorBrush x:Key="NoteCodeBackgroundBrush" Color="#121722" />
    <SolidColorBrush x:Key="DiffAddedBrush" Color="#1B3A2A" />
    <SolidColorBrush x:Key="DiffAddedStrongBrush" Color="#2B6A44" />
    <SolidColorBrush x:Key="DiffRemovedBrush" Color="#41232A" />
    <SolidColorBrush x:Key="DiffRemovedStrongBrush" Color="#7A2F3B" />
    <SolidColorBrush x:Key="ScriptErrorBrush" Color="#F87171" />
    <SolidColorBrush x:Key="ScriptWarningBrush" Color="#FBBF24" />

    <!-- Session tab strip item -->
    <Style x:Key="SessionTabStyle" TargetType="ListBoxItem">
        <Setter Property="Margin" Value="0,0,4,0" />
        <Setter Property="Padding" Value="10,6,4,6" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Bd" CornerRadius="6" Padding="{TemplateBinding Padding}"
                            Background="Transparent" BorderThickness="1" BorderBrush="Transparent">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SessionHeaderBrush}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource ChromeStrokeBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Compact icon button used on toolbars -->
    <Style x:Key="ToolButton" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
        <Setter Property="Padding" Value="8,5" />
        <Setter Property="Margin" Value="2,0" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
    </Style>

    <Style x:Key="SectionHeader" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,18,0,8" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    </Style>

    <Style x:Key="Caption" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <!-- Beside an item's address in the navigation: how it is reached ("via JUMP01") or "not sealed" – in the warning
         colour when that route can't be used; the tooltip says why -->
    <Style x:Key="RouteHintText" TargetType="TextBlock" BasedOn="{StaticResource Caption}">
        <Setter Property="ToolTip" Value="{Binding RouteToolTip}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding RouteUsable}" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- The chevron of an item with contents: points right when closed, down when open -->
    <ControlTemplate x:Key="TreeChevron" TargetType="ToggleButton">
        <Grid x:Name="ChevronContainer" Width="15" Height="15" Background="Transparent" RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform>
                <RotateTransform Angle="0" />
            </Grid.RenderTransform>
            <ui:SymbolIcon Symbol="ChevronRight28" FontSize="10" VerticalAlignment="Center" />
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
                <Trigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation To="90" Duration="0:0:0.16" Storyboard.TargetName="ChevronContainer"
                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)" />
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation To="0" Duration="0:0:0.16" Storyboard.TargetName="ChevronContainer"
                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)" />
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.ExitActions>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- An item with contents in the connection tree (a folder, a jump host, a server with shares, the Favourites) and the
         Scripts view's folders (MainWindow.xaml, Views/ScriptsView.cs): a header row, and its contents a step in beside a
         thin guide line in its colour tag's colour – the line, not a frame, shows what belongs to it. -->
    <ControlTemplate x:Key="FolderItemTemplate" TargetType="TreeViewItem">
        <StackPanel>
            <Border x:Name="Border" CornerRadius="4">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" MinWidth="19" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Rectangle x:Name="ActiveRectangle" RadiusX="2" RadiusY="2" Width="3" Height="16" HorizontalAlignment="Left" VerticalAlignment="Center"
                               Fill="{DynamicResource TreeViewItemSelectionIndicatorForeground}" Visibility="Collapsed" />
                    <ToggleButton x:Name="Expander" Margin="6,0,6,0" ClickMode="Press" Focusable="False" Template="{StaticResource TreeChevron}"
                                  IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}" />
                    <ContentPresenter x:Name="PART_Header" Grid.Column="1" ContentSource="Header" Margin="{TemplateBinding Padding}"
                                      HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                </Grid>
            </Border>
            <Border x:Name="Guide" Margin="13,0,0,2" Padding="6,0,0,0" BorderThickness="1,0,0,0" Visibility="Collapsed">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="BorderBrush" Value="{Binding TagBrush}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding TagBrush}" Value="{x:Null}">
                                <Setter Property="BorderBrush" Value="{DynamicResource ChromeStrokeBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <ItemsPresenter x:Name="ItemsHost" />
            </Border>
        </StackPanel>
        <ControlTemplate.Triggers>
            <Trigger Property="HasItems" Value="False">
                <Setter TargetName="Expander" Property="Visibility" Value="Hidden" />
            </Trigger>
            <Trigger Property="IsExpanded" Value="True">
                <Setter TargetName="Guide" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="IsMouseOver" SourceName="Border" Value="True">
                <Setter TargetName="Border" Property="Background" Value="{DynamicResource TreeViewItemBackgroundPointerOver}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Border" Property="Background" Value="{DynamicResource TreeViewItemBackgroundSelected}" />
                <Setter TargetName="ActiveRectangle" Property="Visibility" Value="Visible" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- A favourite: a chip in the Favourites row (the tree's own item – selection, keys and menu stay the tree's) -->
    <ControlTemplate x:Key="FavoriteChipTemplate" TargetType="TreeViewItem">
        <Border x:Name="Chip" CornerRadius="12" Padding="8,2,10,2" Margin="0,2,6,2" BorderThickness="1" BorderBrush="Transparent"
                Background="{DynamicResource SubtleFillColorSecondaryBrush}">
            <ContentPresenter x:Name="PART_Header" ContentSource="Header" />
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Chip" Property="Background" Value="{DynamicResource TreeViewItemBackgroundPointerOver}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Chip" Property="Background" Value="{DynamicResource TreeViewItemBackgroundSelected}" />
                <Setter TargetName="Chip" Property="BorderBrush" Value="{DynamicResource TreeViewItemSelectionIndicatorForeground}" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>
</ResourceDictionary>
