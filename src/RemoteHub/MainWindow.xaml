<ui:FluentWindow x:Class="RemoteHub.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:m="clr-namespace:RemoteHub.Models"
                 xmlns:vm="clr-namespace:RemoteHub.ViewModels"
        xmlns:r="clr-namespace:RemoteHub.Rdp"
                 xmlns:s="clr-namespace:RemoteHub.Services"
                 xmlns:rm="clr-namespace:RemoteHub.Remoting"
                 xmlns:v="clr-namespace:RemoteHub.Views"
                 Title="RemoteHub" Width="1400" Height="860" MinWidth="820" MinHeight="520"
                 ExtendsContentIntoTitleBar="True" WindowBackdropType="None" WindowCornerPreference="Round"
                 WindowStartupLocation="CenterScreen" AllowDrop="True">
    <Grid Background="{DynamicResource ChromeBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- A newer version is available (shown after the start-up update check) -->
        <Border x:Name="UpdateBanner" Grid.Row="1" Visibility="Collapsed" Margin="10,0,10,8" CornerRadius="8" Padding="12,6" BorderThickness="1"
                Background="{DynamicResource SidebarBackgroundBrush}" BorderBrush="{DynamicResource BrandAccentBrush}">
            <DockPanel>
                <ui:SymbolIcon DockPanel.Dock="Left" Symbol="ArrowCircleDown24" FontSize="18" Margin="0,0,10,0" VerticalAlignment="Center" />
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <ui:Button Content="Details…" Appearance="Primary" Click="UpdateDetails_Click" Margin="0,0,6,0" />
                    <ui:Button Icon="{ui:SymbolIcon Dismiss24}" Click="UpdateBannerClose_Click" ToolTip="Later" AutomationProperties.Name="Hide until next start" />
                </StackPanel>
                <TextBlock x:Name="UpdateBannerText" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>

        <ui:TitleBar x:Name="AppTitleBar" Grid.Row="0" Title="RemoteHub">
            <ui:TitleBar.Icon>
                <ui:ImageIcon x:Name="TitleIcon" Width="18" Height="18" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <Grid Grid.Row="2">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ================= View rail (notes-view-design.md §3) ================= -->
        <v:ViewRail x:Name="Rail" Grid.Column="0" />

        <!-- Notes view (§4); created when first shown -->
        <Border x:Name="NotesHost" Grid.Column="1" Visibility="Hidden" />

        <!-- Scripts view (scripts-view-design.md §4); created when first shown -->
        <Border x:Name="ScriptsHostBorder" Grid.Column="1" Visibility="Hidden" />

        <!-- Remote Control view. Hidden, not collapsed, while another view is shown: the RDP controls keep their size. -->
        <Grid x:Name="RemoteView" Grid.Column="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SidebarColumn" Width="360" MinWidth="300" MaxWidth="700" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition x:Name="TransfersColumn" Width="0" />
            </Grid.ColumnDefinitions>

            <!-- ================= Sidebar ================= -->
            <Border Grid.Column="0" Margin="0,0,2,10" CornerRadius="10" Padding="10,10,8,8"
                    Background="{DynamicResource SidebarBackgroundBrush}" BorderBrush="{DynamicResource ChromeStrokeBrush}" BorderThickness="1">
            <Grid>
            <!-- Collapsed: slim rail -->
            <StackPanel x:Name="SidebarRail" Visibility="Collapsed" HorizontalAlignment="Center">
                <StackPanel.Resources>
                    <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                        <Setter Property="Width" Value="40" />
                        <Setter Property="Height" Value="36" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="HorizontalContentAlignment" Value="Center" />
                    </Style>
                </StackPanel.Resources>
                <ui:Button Icon="{ui:SymbolIcon PanelLeftExpand24}" Click="ToggleSidebar_Click" Margin="0,0,0,8"
                           AutomationProperties.Name="Show navigation" ToolTip="Show navigation (Ctrl+B)" />
                <ui:Button x:Name="RailNewButton" Icon="{ui:SymbolIcon Add24}" Appearance="Primary" Click="NewMenu_Click" Margin="0,0,0,8"
                           AutomationProperties.Name="New" ToolTip="New connection (Remote Control, SSH, SFTP, FTP, SMB, WebDAV), folder or import .rdp files" />
                <ui:Button Icon="{ui:SymbolIcon Search24}" Click="RailSearch_Click"
                           AutomationProperties.Name="Search" ToolTip="Search folders &amp; connections (Ctrl+F)" Margin="0,0,0,8" />
            </StackPanel>
            <Grid x:Name="SidebarFull">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Margin="0,0,0,8" LastChildFill="False">
                    <!-- New (menu) and collapse; Settings is on the view rail, app items live in Settings -->
                    <ui:Button x:Name="NewButton" DockPanel.Dock="Left" Appearance="Primary" Click="NewMenu_Click"
                               AutomationProperties.Name="New" ToolTip="New connection (Remote Control with Ctrl+N, SSH, SFTP, FTP, SMB, WebDAV), new folder (Ctrl+Shift+N) or import .rdp files">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Add24" FontSize="16" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="New" VerticalAlignment="Center" />
                            <ui:SymbolIcon Symbol="ChevronDown24" FontSize="12" Margin="8,1,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <ui:Button.ContextMenu>
                            <ContextMenu>
                                <!-- Its kinds are filled in when the menu opens (FillNewConnection), as in the tree's New menus -->
                                <MenuItem x:Name="NewMenuConnection" Header="New connection" Icon="{ui:SymbolIcon Desktop24}" />
                                <MenuItem Header="New folder" Click="NewFolder_Click" Icon="{ui:SymbolIcon FolderAdd24}" InputGestureText="Ctrl+Shift+N" />
                                <Separator x:Name="NewMenuImportSep" />
                                <MenuItem x:Name="NewMenuImport" Header="Import .rdp files…" Click="ImportRdp_Click" Icon="{ui:SymbolIcon DocumentAdd24}" />
                            </ContextMenu>
                        </ui:Button.ContextMenu>
                    </ui:Button>
                    <ui:Button DockPanel.Dock="Right" Margin="6,0,0,0" Icon="{ui:SymbolIcon PanelLeftContract24}" Click="ToggleSidebar_Click"
                               AutomationProperties.Name="Hide navigation" ToolTip="Hide navigation (Ctrl+B)" />
                </DockPanel>

                <DockPanel Grid.Row="1" Margin="0,0,0,8">
                    <!-- "Not used for …" filter: lists connections nobody opened for a while, to clean them up -->
                    <ui:Button x:Name="UnusedFilterButton" DockPanel.Dock="Right" Margin="6,0,0,0" Icon="{ui:SymbolIcon Filter24}"
                               Click="UnusedFilter_Click" AutomationProperties.Name="Filter: not used for"
                               ToolTip="Show connections that haven't been used for a while (to clean them up)">
                        <ui:Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="All connections" Tag="0" Click="UnusedFilterItem_Click" />
                                <Separator />
                                <MenuItem Header="Not used for 30 days" Tag="30" Click="UnusedFilterItem_Click" />
                                <MenuItem Header="Not used for 90 days" Tag="90" Click="UnusedFilterItem_Click" />
                                <MenuItem Header="Not used for 6 months" Tag="180" Click="UnusedFilterItem_Click" />
                                <MenuItem Header="Not used for a year" Tag="365" Click="UnusedFilterItem_Click" />
                                <Separator />
                                <MenuItem Header="Never connected" Tag="-1" Click="UnusedFilterItem_Click" />
                                <Separator />
                                <!-- One line per item, or the address on a second line (the setting is kept) -->
                                <MenuItem x:Name="CompactRowsItem" Header="Compact rows" IsCheckable="True" IsChecked="{Binding CompactTree, Mode=TwoWay}" />
                            </ContextMenu>
                        </ui:Button.ContextMenu>
                    </ui:Button>
                    <ui:TextBox x:Name="SearchBox"
                                PlaceholderText="Search folders &amp; connections" ToolTip="Search folders &amp; connections, or type a computer name to quick-connect (Ctrl+F)"
                                Icon="{ui:SymbolIcon Search24}" ClearButtonEnabled="True"
                                Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                PreviewKeyDown="SearchBox_PreviewKeyDown" />
                </DockPanel>

                <Grid x:Name="TreeArea" Grid.Row="2">
                    <TreeView x:Name="Tree" AllowDrop="True"
                              Background="Transparent" BorderThickness="0"
                              VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                              VirtualizingPanel.ScrollUnit="Pixel" ScrollViewer.CanContentScroll="True"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled" Padding="0,0,12,0"
                              Visibility="{Binding IsSearching, Converter={StaticResource InvBoolToVis}}"
                              SelectedItemChanged="Tree_SelectedItemChanged"
                              PreviewMouseLeftButtonDown="Tree_PreviewMouseLeftButtonDown"
                              PreviewMouseMove="Tree_PreviewMouseMove"
                              PreviewMouseRightButtonDown="Tree_PreviewMouseRightButtonDown"
                              MouseDoubleClick="Tree_MouseDoubleClick"
                              KeyDown="Tree_KeyDown"
                              DragOver="Tree_DragOver" Drop="Tree_Drop" DragLeave="Tree_DragLeave">
                        <TreeView.Resources>
                            <HierarchicalDataTemplate DataType="{x:Type m:Folder}" ItemsSource="{Binding Children}">
                                <StackPanel Orientation="Horizontal" Margin="0,2" Background="Transparent" ToolTip="" ToolTipOpening="TreeItem_ToolTipOpening">
                                    <Grid Margin="0,0,8,0" VerticalAlignment="Center">
                                        <ui:SymbolIcon Symbol="{Binding DisplaySymbol}" FontSize="16"
                                                       Foreground="{Binding TagBrush, TargetNullValue={StaticResource BrandAccentBrush}}"
                                                       Visibility="{Binding IconImage, Converter={StaticResource InvBoolToVis}}" />
                                        <Image Source="{Binding IconImage, Converter={StaticResource Base64Image}}" Width="16" Height="16"
                                               Visibility="{Binding IconImage, Converter={StaticResource BoolToVis}}" />
                                    </Grid>
                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                    <ui:SymbolIcon Symbol="Key24" FontSize="12" Margin="6,0,0,0"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                   Visibility="{Binding InheritCredentials, Converter={StaticResource InvBoolToVis}}" />
                                    <!-- Number of items inside (or "empty"), so it's visible what belongs to the folder. -->
                                    <Border Margin="8,0,0,0" Padding="6,0" CornerRadius="8" VerticalAlignment="Center"
                                            Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                                        <TextBlock FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="{Binding Children.Count}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Children.Count}" Value="0">
                                                            <Setter Property="Text" Value="empty" />
                                                            <Setter Property="FontStyle" Value="Italic" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </StackPanel>
                            </HierarchicalDataTemplate>
                            <!-- Network shares and SSH: below a server (one line), or on their own in a folder like a connection – the
                                 address beside the name (Compact rows), or below it -->
                            <DataTemplate DataType="{x:Type m:NetworkShare}">
                                <Grid Margin="0,1" Background="Transparent" ToolTip="{Binding Address}" ContextMenuOpening="ShareItem_ContextMenuOpening">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Border Grid.RowSpan="2" Width="3" CornerRadius="1.5" Margin="0,2,7,2" Background="{Binding TagBrush}">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Visibility" Value="Visible" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsStandalone}" Value="False">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding TagBrush}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                    </Border>
                                    <Grid Grid.Column="1" Grid.RowSpan="2" Margin="0,0,8,0" VerticalAlignment="Center">
                                        <ui:SymbolIcon Symbol="{Binding DisplaySymbol}">
                                            <ui:SymbolIcon.Style>
                                                <Style TargetType="ui:SymbolIcon">
                                                    <Setter Property="FontSize" Value="14" />
                                                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsStandalone}" Value="True">
                                                            <Setter Property="FontSize" Value="16" />
                                                            <Setter Property="Foreground" Value="{Binding TagBrush, TargetNullValue={StaticResource TextFillColorPrimaryBrush}}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ui:SymbolIcon.Style>
                                        </ui:SymbolIcon>
                                        <Ellipse Width="7" Height="7" Fill="{DynamicResource SystemFillColorSuccessBrush}" HorizontalAlignment="Right"
                                                 VerticalAlignment="Bottom" Margin="0,0,-2,-1"
                                                 Visibility="{Binding OpenTabs, Converter={StaticResource BoolToVis}}" />
                                    </Grid>
                                    <DockPanel Grid.Column="2" VerticalAlignment="Center">
                                        <TextBlock DockPanel.Dock="Left" Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        <TextBlock DockPanel.Dock="Left" Text="{Binding ProtocolLabel}" Style="{StaticResource Caption}" FontSize="11" Margin="8,0,0,0" VerticalAlignment="Center" />
                                        <!-- Compact rows, on its own: the route and the address beside the name -->
                                        <DockPanel Margin="8,0,0,0">
                                            <DockPanel.Style>
                                                <Style TargetType="DockPanel">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding IsStandalone}" Value="True" />
                                                                <Condition Binding="{Binding DataContext.CompactTree, RelativeSource={RelativeSource AncestorType=TreeView}}" Value="True" />
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </MultiDataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </DockPanel.Style>
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding RouteHint}" FontSize="11" Margin="8,0,0,0" VerticalAlignment="Center"
                                                       Visibility="{Binding RouteHint, Converter={StaticResource BoolToVis}}" Style="{StaticResource RouteHintText}" />
                                            <TextBlock Text="{Binding Address}" Style="{StaticResource Caption}" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        </DockPanel>
                                    </DockPanel>
                                    <!-- Two-line rows, on its own: the route and the address below -->
                                    <DockPanel Grid.Column="2" Grid.Row="1">
                                        <DockPanel.Style>
                                            <Style TargetType="DockPanel">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding IsStandalone}" Value="True" />
                                                            <Condition Binding="{Binding DataContext.CompactTree, RelativeSource={RelativeSource AncestorType=TreeView}}" Value="False" />
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </MultiDataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </DockPanel.Style>
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding RouteHint}" FontSize="11" Margin="8,0,0,0" VerticalAlignment="Center"
                                                   Visibility="{Binding RouteHint, Converter={StaticResource BoolToVis}}" Style="{StaticResource RouteHintText}" />
                                        <TextBlock Text="{Binding Address}" Style="{StaticResource Caption}" FontSize="11" TextTrimming="CharacterEllipsis" />
                                    </DockPanel>
                                </Grid>
                            </DataTemplate>
                            <!-- Favourites: links to pinned connections, as chips in a row; the connections stay in their folders -->
                            <HierarchicalDataTemplate DataType="{x:Type m:FavoritesGroup}" ItemsSource="{Binding Children}">
                                <StackPanel Orientation="Horizontal" Margin="0,2">
                                    <ui:SymbolIcon Symbol="Star24" Filled="True" FontSize="16" Margin="0,0,8,0" Foreground="{DynamicResource SystemAccentColorPrimaryBrush}" />
                                    <TextBlock Text="Favourites" FontWeight="SemiBold" VerticalAlignment="Center" />
                                </StackPanel>
                            </HierarchicalDataTemplate>
                            <DataTemplate DataType="{x:Type m:FavoriteLink}">
                                <!-- The connection's colour tag, icon (with its session state) and name; the tooltip says where it lives -->
                                <StackPanel Orientation="Horizontal" DataContext="{Binding Target}" Background="Transparent" ToolTip="" ToolTipOpening="TreeItem_ToolTipOpening">
                                    <Border Width="3" Height="12" CornerRadius="1.5" Margin="0,0,6,0" Background="{Binding TagBrush}"
                                            Visibility="{Binding TagBrush, Converter={StaticResource BoolToVis}}" />
                                    <Grid Margin="0,0,6,0" VerticalAlignment="Center">
                                        <ui:SymbolIcon Symbol="{Binding DisplaySymbol}" FontSize="14"
                                                       Foreground="{Binding TagBrush, TargetNullValue={StaticResource TextFillColorSecondaryBrush}}"
                                                       Visibility="{Binding IconImage, Converter={StaticResource InvBoolToVis}}" />
                                        <Image Source="{Binding IconImage, Converter={StaticResource Base64Image}}" Width="14" Height="14"
                                               Visibility="{Binding IconImage, Converter={StaticResource BoolToVis}}" />
                                        <Ellipse Width="6" Height="6" Fill="{Binding LiveState, Converter={StaticResource StateBrush}}" HorizontalAlignment="Right"
                                                 VerticalAlignment="Bottom" Margin="0,0,-2,-1"
                                                 Visibility="{Binding OpenSessions, Converter={StaticResource BoolToVis}}" />
                                    </Grid>
                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                </StackPanel>
                            </DataTemplate>
                            <!-- A connection: its shares, then the connections and folders reached through it (a jump host) -->
                            <HierarchicalDataTemplate DataType="{x:Type m:Connection}">
                                <HierarchicalDataTemplate.ItemsSource>
                                    <MultiBinding Converter="{StaticResource Concat}">
                                        <Binding Path="Shares" />
                                        <Binding Path="Children" />
                                    </MultiBinding>
                                </HierarchicalDataTemplate.ItemsSource>
                                <!-- One line (Compact rows): colour tag, the icon with its marks, the name, the address and route, when it
                                     was last used. Two-line rows put the address and route below the name. -->
                                <Grid Margin="0,1" Background="Transparent" ToolTip="" ToolTipOpening="TreeItem_ToolTipOpening">
                                    <!-- A broker device whose record isn't sealed by the organisation: greyed, it can't be opened -->
                                    <Grid.Style>
                                        <Style TargetType="Grid">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding BrokerUnsealed}" Value="True">
                                                    <Setter Property="Opacity" Value="0.55" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Grid.Style>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Border Grid.RowSpan="2" Width="3" CornerRadius="1.5" Margin="0,2,7,2" Background="{Binding TagBrush}"
                                            Visibility="{Binding TagBrush, Converter={StaticResource BoolToVis}}" />
                                    <!-- The icon carries the marks: the RemoteHub Agent (a shield at the top, filled while it is used), the state
                                         at a RemoteHub Broker (a dot: green online, red offline, yellow unknown) and an open tab's state (a dot, over it) -->
                                    <Grid Grid.Column="1" Grid.RowSpan="2" Margin="0,0,8,0" VerticalAlignment="Center">
                                        <ui:SymbolIcon Symbol="{Binding DisplaySymbol}" FontSize="16"
                                                       Foreground="{Binding TagBrush, TargetNullValue={StaticResource TextFillColorPrimaryBrush}}"
                                                       Visibility="{Binding IconImage, Converter={StaticResource InvBoolToVis}}" />
                                        <Image Source="{Binding IconImage, Converter={StaticResource Base64Image}}" Width="16" Height="16"
                                               Visibility="{Binding IconImage, Converter={StaticResource BoolToVis}}" />
                                        <ui:SymbolIcon Symbol="Shield24" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-4,-5,0"
                                                       ToolTip="{Binding AgentToolTip}">
                                            <ui:SymbolIcon.Style>
                                                <Style TargetType="ui:SymbolIcon">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding AgentMode}" Value="Active">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                            <Setter Property="Filled" Value="True" />
                                                            <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding AgentMode}" Value="Available">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ui:SymbolIcon.Style>
                                        </ui:SymbolIcon>
                                        <Ellipse Width="8" Height="8" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-3,-2"
                                                 StrokeThickness="1.5" Stroke="{DynamicResource SidebarBackgroundBrush}" ToolTip="{Binding RouteToolTip}">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="Fill" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding BrokerPresence}" Value="None">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding BrokerPresence}" Value="Online">
                                                            <Setter Property="Fill" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding BrokerPresence}" Value="Offline">
                                                            <Setter Property="Fill" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                        <Ellipse Width="8" Height="8" Fill="{Binding LiveState, Converter={StaticResource StateBrush}}" HorizontalAlignment="Right"
                                                 VerticalAlignment="Bottom" Margin="0,0,-3,-2" StrokeThickness="1.5" Stroke="{DynamicResource SidebarBackgroundBrush}"
                                                 Visibility="{Binding OpenSessions, Converter={StaticResource BoolToVis}}" />
                                    </Grid>
                                    <DockPanel Grid.Column="2" VerticalAlignment="Center">
                                        <TextBlock DockPanel.Dock="Left" Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                        <!-- Compact rows: the address and the route beside the name -->
                                        <DockPanel Margin="8,0,0,0" Visibility="{Binding DataContext.CompactTree, RelativeSource={RelativeSource AncestorType=TreeView}, Converter={StaticResource BoolToVis}}">
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding RouteHint}" FontSize="11" Margin="6,0,0,0" VerticalAlignment="Center"
                                                       Visibility="{Binding RouteHint, Converter={StaticResource BoolToVis}}" Style="{StaticResource RouteHintText}" />
                                            <TextBlock Text="{Binding Address}" Style="{StaticResource Caption}" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        </DockPanel>
                                    </DockPanel>
                                    <!-- When it was last used (any tab), or that it never was: short in one line, in full on two -->
                                    <TextBlock Grid.Column="3" FontSize="11" Margin="8,0,0,0" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource Caption}">
                                                <Setter Property="Text" Value="{Binding LastUsedShort}" />
                                                <Setter Property="ToolTip" Value="{Binding LastUsedToolTip}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding DataContext.CompactTree, RelativeSource={RelativeSource AncestorType=TreeView}}" Value="False">
                                                        <Setter Property="Text" Value="{Binding LastUsedText}" />
                                                        <Setter Property="ToolTip" Value="Last connected" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding NeverConnected}" Value="True">
                                                        <Setter Property="FontStyle" Value="Italic" />
                                                        <Setter Property="Opacity" Value="0.7" />
                                                        <Setter Property="ToolTip" Value="No connection recorded yet" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <!-- Two-line rows: the address and the route below the name -->
                                    <DockPanel Grid.Column="2" Grid.ColumnSpan="2" Grid.Row="1"
                                               Visibility="{Binding DataContext.CompactTree, RelativeSource={RelativeSource AncestorType=TreeView}, Converter={StaticResource InvBoolToVis}}">
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding RouteHint}" FontSize="11" Margin="8,0,0,0" VerticalAlignment="Center"
                                                   Visibility="{Binding RouteHint, Converter={StaticResource BoolToVis}}" Style="{StaticResource RouteHintText}" />
                                        <TextBlock Text="{Binding Address}" Style="{StaticResource Caption}" FontSize="11" TextTrimming="CharacterEllipsis" />
                                    </DockPanel>
                                    <TextBlock Grid.Column="2" Grid.ColumnSpan="2" Grid.Row="2" Text="Checking PowerShell remoting…" Style="{StaticResource Caption}" FontSize="11"
                                               Foreground="{DynamicResource SystemAccentColorPrimaryBrush}"
                                               Visibility="{Binding PsChecking, Converter={StaticResource BoolToVis}}" />
                                </Grid>
                            </HierarchicalDataTemplate>
                        </TreeView.Resources>
                        <!-- Only the rows on screen are built (a few hundred connections with their shares took seconds to lay out at start) -->
                        <TreeView.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel />
                            </ItemsPanelTemplate>
                        </TreeView.ItemsPanel>
                        <TreeView.ItemContainerStyle>
                            <Style TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
                                <Setter Property="ItemsPanel">
                                    <Setter.Value>
                                        <ItemsPanelTemplate>
                                            <VirtualizingStackPanel />
                                        </ItemsPanelTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                                <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                                <!-- Rows take the tree's width: long addresses are cut with "…", and the last use sits at the right edge -->
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Style.Triggers>
                                    <!-- Whatever holds something – a folder (also an empty one), a jump host, a server with shares – shows
                                         its contents a step in beside a guide line -->
                                    <Trigger Property="HasItems" Value="True">
                                        <Setter Property="Template" Value="{StaticResource FolderItemTemplate}" />
                                    </Trigger>
                                    <DataTrigger Binding="{Binding IsFolder}" Value="True">
                                        <Setter Property="Template" Value="{StaticResource FolderItemTemplate}" />
                                    </DataTrigger>
                                    <!-- Favourites: the links as chips, side by side -->
                                    <DataTrigger Binding="{Binding IsFavorites}" Value="True">
                                        <Setter Property="ItemsPanel">
                                            <Setter.Value>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel Margin="0,2,0,4" />
                                                </ItemsPanelTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsFavoriteLink}" Value="True">
                                        <Setter Property="Template" Value="{StaticResource FavoriteChipTemplate}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TreeView.ItemContainerStyle>
                        <TreeView.ContextMenu>
                            <ContextMenu x:Name="TreeMenu" Opened="TreeMenu_Opened">
                                <MenuItem x:Name="CmConnect" Header="Connect" FontWeight="SemiBold" Click="CmConnect_Click" Icon="{ui:SymbolIcon PlugConnected24}" />
                                <MenuItem x:Name="CmConnectNew" Header="Open additional session" Click="CmConnectNew_Click" Icon="{ui:SymbolIcon WindowNew24}" />
                                <MenuItem x:Name="CmDesktopOther" Click="CmDesktopOther_Click" />
                                <MenuItem x:Name="CmOpenApp" Header="Open app" Icon="{ui:SymbolIcon Apps24}" />
                                <MenuItem x:Name="CmConnectAll" Header="Connect all in folder" Click="CmConnectAll_Click" Icon="{ui:SymbolIcon PlugConnected24}" />
                                <Separator x:Name="CmPsSep" />
                                <!-- Groups open on hover: tools for the device, setting it up, and the rarer actions (more, new). -->
                                <MenuItem x:Name="CmTools" Header="Tools" Icon="{ui:SymbolIcon Toolbox24}">
                                    <MenuItem x:Name="CmPs" Header="PowerShell" Click="CmPs_Click" Icon="{ui:SymbolIcon WindowConsole20}" />
                                    <MenuItem x:Name="CmRunScript" Header="Run script…" Click="CmRunScript_Click" Icon="{ui:SymbolIcon Play24}"
                                              ToolTip="Run a deployed PowerShell script from the Scripts view on this device" />
                                    <MenuItem x:Name="CmSendFiles" Header="File transfer" Click="CmSendFiles_Click" Icon="{ui:SymbolIcon FolderSwap24}" />
                                    <MenuItem x:Name="CmRegistry" Header="Registry" Click="CmRegistry_Click" Icon="{ui:SymbolIcon CubeTree24}" />
                                    <MenuItem x:Name="CmServices" Header="Services" Click="CmServices_Click" Icon="{ui:SymbolIcon WrenchScrewdriver24}" />
                                    <MenuItem x:Name="CmProcesses" Header="Processes" Click="CmProcesses_Click" Icon="{ui:SymbolIcon Pulse24}" />
                                    <MenuItem x:Name="CmPsTest" Header="Test PowerShell remoting" Click="CmPsTest_Click" Icon="{ui:SymbolIcon ArrowSync24}" />
                                    <Separator x:Name="CmSharesSep" />
                                    <MenuItem x:Name="CmAddShare" Header="Add network share…" Click="CmAddShare_Click" Icon="{ui:SymbolIcon FolderLink24}"
                                              ToolTip="An SMB, SFTP, FTP or WebDAV share of this server – opened in a file tab, no agent needed" />
                                </MenuItem>
                                <!-- Lock, restart and the other device actions: filled when the menu opens, as in the session tab's menu (MainWindow.DeviceActions.cs) -->
                                <MenuItem x:Name="CmDevice" Header="Device actions" Icon="{ui:SymbolIcon Flash24}" />
                                <MenuItem x:Name="CmManage" Header="RemoteHub Agent" Icon="{ui:SymbolIcon Shield24}">
                                    <MenuItem x:Name="CmPsSetup" Header="Set up PowerShell remoting on the target…" Click="CmPsSetup_Click" Icon="{ui:SymbolIcon Code24}" />
                                    <MenuItem x:Name="CmAgent" Header="Install RemoteHub Agent…" Click="CmAgent_Click" Icon="{ui:SymbolIcon Shield24}" />
                                    <MenuItem x:Name="CmAgentClaim" Header="Claim RemoteHub Agent…" Click="CmAgentClaim_Click" Icon="{ui:SymbolIcon ShieldCheckmark24}"
                                              ToolTip="For an agent installed with this RemoteHub's enrollment file (Intune, software distribution): pins the certificate it made" />
                                    <!-- One entry per connected organisation, or a single item: filled when the menu opens (MainWindow.Broker.cs) -->
                                    <MenuItem x:Name="CmAgentBroker" Header="Assign to RemoteHub Broker…" Click="CmAgentBroker_Click" Icon="{ui:SymbolIcon CloudLink24}"
                                              ToolTip="Joins the device's agent to your organisation at the RemoteHub Broker, so every console reaches it from anywhere" />
                                    <MenuItem x:Name="CmCredentialProvider" Header="Install credential provider" Click="CmCredentialProvider_Click" Icon="{ui:SymbolIcon Key24}"
                                              ToolTip="Lets the RemoteHub Agent sign in automatically on the device's sign-in screen" />
                                    <MenuItem x:Name="CmAgentUninstall" Header="Uninstall RemoteHub Agent…" Click="CmAgentUninstall_Click" Icon="{ui:SymbolIcon Delete24}"
                                              ToolTip="Removes the agent from the device; the connection goes back to RDP and PowerShell remoting" />
                                </MenuItem>
                                <MenuItem x:Name="CmNotes" Header="Notes" Click="CmNotes_Click" Icon="{ui:SymbolIcon Notebook24}" />
                                <MenuItem x:Name="CmFavorite" Header="Add to favourites" Click="CmFavorite_Click" Icon="{ui:SymbolIcon Star24}"
                                          ToolTip="Pins a link to the top of the navigation; the connection stays in its folder" />
                                <Separator x:Name="CmSep1" />
                                <MenuItem x:Name="CmEdit" Header="Edit…" InputGestureText="F2" Click="CmEdit_Click" Icon="{ui:SymbolIcon Edit24}" />
                                <MenuItem x:Name="CmDuplicate" Header="Duplicate" Click="CmDuplicate_Click" Icon="{ui:SymbolIcon Copy24}" />
                                <!-- Filled when the menu opens (Views/ColorMenu.cs), as in Notes and Scripts -->
                                <MenuItem x:Name="CmColour" Header="Colour" Icon="{ui:SymbolIcon Color24}" />
                                <MenuItem x:Name="CmMoveUnder" Header="Move under" Icon="{ui:SymbolIcon Router24}"
                                          ToolTip="Reach it through another connection's RemoteHub Agent (a jump host) – or directly again" />
                                <MenuItem x:Name="CmDelete" Header="Delete" InputGestureText="Del" Click="CmDelete_Click" Icon="{ui:SymbolIcon Delete24}" />
                                <MenuItem x:Name="CmMore" Header="More" Icon="{ui:SymbolIcon MoreHorizontal24}">
                                    <MenuItem x:Name="CmHistory" Header="Audit log…" Click="CmHistory_Click" Icon="{ui:SymbolIcon DocumentBulletList24}"
                                              ToolTip="The audit log of this connection: its sessions, changes and file transfers" />
                                    <MenuItem x:Name="CmSaveRdp" Header="Save as .rdp file…" Click="CmSaveRdp_Click" Icon="{ui:SymbolIcon ArrowExport24}" />
                                    <MenuItem x:Name="CmScriptRuns" Header="Run history…" Click="CmScriptRuns_Click" Icon="{ui:SymbolIcon History24}"
                                              ToolTip="The scripts run on this device from this PC, with their output" />
                                    <MenuItem x:Name="CmRecentlyDeleted" Header="Recently deleted…" Click="CmRecentlyDeleted_Click" Icon="{ui:SymbolIcon Delete24}"
                                              ToolTip="Deleted folders and connections, kept for 30 days" />
                                </MenuItem>
                                <Separator x:Name="CmNewSep" />
                                <MenuItem x:Name="CmNew" Header="New" Icon="{ui:SymbolIcon Add24}">
                                    <MenuItem x:Name="CmNewConnection" Header="Connection" Icon="{ui:SymbolIcon Add24}" />
                                    <MenuItem Header="Folder" Click="NewFolder_Click" Icon="{ui:SymbolIcon FolderAdd24}" />
                                </MenuItem>
                            </ContextMenu>
                        </TreeView.ContextMenu>
                    </TreeView>

                    <Grid Visibility="{Binding IsSearching, Converter={StaticResource BoolToVis}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <!-- The "not used for" filter: what is shown, and deleting all of it at once -->
                    <Border Padding="8,6" Margin="0,0,0,6" CornerRadius="6" Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                            Visibility="{Binding IsFiltering, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock Text="{Binding UnusedSummary}" TextWrapping="Wrap" FontSize="12" />
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <ui:Button x:Name="DeleteUnusedButton" Content="Delete these…" Icon="{ui:SymbolIcon Delete24}" Appearance="Danger" Click="DeleteUnused_Click"
                                           Visibility="{Binding SearchResults.Count, Converter={StaticResource BoolToVis}}" Margin="0,0,6,0" />
                                <ui:Button Content="Show all" Click="ClearUnusedFilter_Click" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <ListBox x:Name="SearchList" Grid.Row="1" ItemsSource="{Binding SearchResults}" Background="Transparent" BorderThickness="0"
                             MouseDoubleClick="SearchList_MouseDoubleClick" KeyDown="SearchList_KeyDown"
                             PreviewMouseRightButtonDown="SearchList_PreviewMouseRightButtonDown">
                        <ListBox.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Open / go to folder" FontWeight="SemiBold" Click="SearchOpen_Click" Icon="{ui:SymbolIcon PlugConnected24}" />
                                <MenuItem Header="Show in list" Click="SearchReveal_Click" Icon="{ui:SymbolIcon Search24}" />
                            </ContextMenu>
                        </ListBox.ContextMenu>
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type s:SearchHit}">
                                <Grid Margin="0,2" Background="Transparent" ToolTip="" ToolTipOpening="TreeItem_ToolTipOpening">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="3" CornerRadius="1.5" Margin="0,2,7,2" Background="{Binding Node.TagBrush}"
                                            Visibility="{Binding Node.TagBrush, Converter={StaticResource BoolToVis}}" />
                                    <Grid Grid.Column="1" Margin="0,0,8,0" VerticalAlignment="Center">
                                        <ui:SymbolIcon Symbol="{Binding Node.DisplaySymbol}" FontSize="16"
                                                       Foreground="{Binding Node.TagBrush, TargetNullValue={StaticResource BrandAccentBrush}}"
                                                       Visibility="{Binding Node.IconImage, Converter={StaticResource InvBoolToVis}}" />
                                        <Image Source="{Binding Node.IconImage, Converter={StaticResource Base64Image}}" Width="16" Height="16"
                                               Visibility="{Binding Node.IconImage, Converter={StaticResource BoolToVis}}" />
                                    </Grid>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="{Binding Node.Name}" />
                                        <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Caption}" FontSize="11" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Grid.Row="1" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="6,8" VerticalAlignment="Top"
                               Visibility="{Binding SearchResults.Count, Converter={StaticResource InvBoolToVis}}" Text="{Binding EmptySearchText}" />
                    </Grid>

                    <!-- Empty state -->
                    <StackPanel x:Name="EmptyHint" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="12" IsHitTestVisible="False">
                        <ui:SymbolIcon Symbol="DocumentAdd24" FontSize="36" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                        <TextBlock Margin="0,10,0,0" TextAlignment="Center" TextWrapping="Wrap" Style="{StaticResource Caption}"
                                   Text="No connections yet.&#x0a;Click New, or drop .rdp files here." />
                    </StackPanel>

                    <Border x:Name="DropIndicator" Height="2" VerticalAlignment="Top" HorizontalAlignment="Stretch"
                            Background="{DynamicResource SystemAccentColorPrimaryBrush}" Visibility="Collapsed" IsHitTestVisible="False" />
                </Grid>

                <StackPanel Grid.Row="4" Margin="2,8,0,0">
                    <TextBlock Style="{StaticResource Caption}">
                        <Run Text="{Binding ConnectionCount, Mode=OneWay}" /><Run Text=" connections  ·  " /><Run Text="{Binding Sessions.Count, Mode=OneWay}" /><Run Text=" open" />
                    </TextBlock>
                    <TextBlock Text="{Binding StorageInfo}" Style="{StaticResource Caption}" FontSize="11" Margin="0,2,0,0"
                               ToolTip="{Binding StorageInfo}" />
                    <TextBlock Text="{Binding SaveError}" Foreground="#E5484D" TextWrapping="Wrap"
                               Visibility="{Binding SaveError, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
            </Grid>
            </Grid>
            </Border>

            <GridSplitter x:Name="MainSplitter" Grid.Column="1" Width="5" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                          Background="Transparent" ResizeBehavior="PreviousAndNext" DragCompleted="Splitter_DragCompleted" />

            <!-- ================= Sessions ================= -->
            <Border x:Name="SessionArea" Grid.Column="2" Margin="2,0,10,10" CornerRadius="10"
                    Background="{DynamicResource SidebarBackgroundBrush}"
                    BorderBrush="{DynamicResource ChromeStrokeBrush}" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Tab rows: one tab per connection (+ toolbar). A second row with that connection's tabs
                         (remote desktop, PowerShell, file transfer, registry) appears only when it has more than one. -->
                    <StackPanel Grid.Row="0" Margin="6,6,6,4" Visibility="{Binding HasSessions, Converter={StaticResource BoolToVis}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ListBox x:Name="GroupTabs" Grid.Column="0" ItemsSource="{Binding Groups}" SelectedItem="{Binding GroupSelection}"
                                     ItemContainerStyle="{StaticResource SessionTabStyle}" Background="Transparent" BorderThickness="0"
                                     ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                     PreviewMouseUp="GroupTabs_PreviewMouseUp" PreviewMouseWheel="Tabs_PreviewMouseWheel"
                                     PreviewMouseRightButtonUp="GroupTabs_PreviewMouseRightButtonUp">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:SessionGroup}">
                                        <Grid>
                                        <Border Height="3" CornerRadius="1.5" VerticalAlignment="Bottom" Margin="0,0,4,-5"
                                                Background="{Binding AccentBrush}"
                                                Visibility="{Binding IsSelected, Converter={StaticResource BoolToVisHidden}}" />
                                        <StackPanel Orientation="Horizontal" ToolTip="{Binding Tooltip}">
                                            <Ellipse Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center"
                                                     Fill="{Binding Connection.LiveState, Converter={StaticResource StateBrush}}" />
                                            <ui:SymbolIcon Symbol="{Binding SingleSymbol}" FontSize="14" Margin="0,0,6,0"
                                                           Visibility="{Binding ShowSingleSymbol, Converter={StaticResource BoolToVis}}" />
                                            <TextBlock Text="{Binding Connection.Name}" MaxWidth="200" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" FontWeight="SemiBold" />
                                            <Border Margin="6,0,0,0" Padding="5,0,5,1" CornerRadius="4" Background="#E5484D" VerticalAlignment="Center"
                                                    Visibility="{Binding IsRecording, Converter={StaticResource BoolToVis}}" ToolTip="Being recorded">
                                                <TextBlock Text="REC" FontSize="10" FontWeight="Bold" Foreground="White" />
                                            </Border>
                                            <Border Margin="8,0,0,0" Padding="6,0" CornerRadius="8" VerticalAlignment="Center" Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                                    Visibility="{Binding HasMultiple, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="{Binding Sessions.Count}" FontSize="11" />
                                            </Border>
                                            <Button Margin="6,0,0,0" Padding="3" MinWidth="0" Background="Transparent" BorderThickness="0"
                                                    Click="GroupClose_Click" ToolTip="Close all tabs of this connection" Cursor="Arrow">
                                                <ui:SymbolIcon Symbol="Dismiss24" FontSize="12" />
                                            </Button>
                                        </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <ui:Button x:Name="AddTabButton" Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="2,0,0,0"
                                       Style="{StaticResource ToolButton}" Icon="{ui:SymbolIcon Add24}" Click="AddTab_Click"
                                       AutomationProperties.Name="Open another tab for this connection" ToolTip="Open remote desktop, PowerShell, file transfer or registry for this connection" />
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                                <ui:Button Style="{StaticResource ToolButton}" Icon="{ui:SymbolIcon ArrowClockwise24}" Click="Reconnect_Click" AutomationProperties.Name="Reconnect" ToolTip="Reconnect" />
                                <ui:Button Style="{StaticResource ToolButton}" Icon="{ui:SymbolIcon PlugDisconnected24}" Click="Disconnect_Click" AutomationProperties.Name="Disconnect" ToolTip="Disconnect" />
                                <ui:Button Style="{StaticResource ToolButton}" Icon="{ui:SymbolIcon Keyboard24}" Content="Ctrl+Alt+Del" Click="CtrlAltDel_Click" AutomationProperties.Name="Send Ctrl+Alt+Del to the session" ToolTip="Send Ctrl+Alt+Del to the session"
                                           Visibility="{Binding SelectedIsRdp, Converter={StaticResource BoolToVis}}" />
                                <ui:Button Style="{StaticResource ToolButton}" Icon="{ui:SymbolIcon FullScreenMaximize24}" Click="FullScreen_Click" AutomationProperties.Name="Full screen" ToolTip="Full screen (leave with the connection bar or Ctrl+Alt+Break)"
                                           Visibility="{Binding SelectedIsRdp, Converter={StaticResource BoolToVis}}" />
                                <ui:Button x:Name="SendFilesButton" Style="{StaticResource ToolButton}" Icon="{ui:SymbolIcon FolderSwap24}" Content="File transfer" Click="ToolbarSendFiles_Click" AutomationProperties.Name="Open file transfer" ToolTip="Open a file transfer tab at the current folder of this PowerShell session"
                                           Visibility="Collapsed" />
                                <ui:Button x:Name="RecordButton" Style="{StaticResource ToolButton}" Icon="{ui:SymbolIcon Record24}" Click="Record_Click"
                                           AutomationProperties.Name="Record this tab to a video file" ToolTip="Record this tab to a video file" />
                                <ui:Button Style="{StaticResource ToolButton}" Icon="{ui:SymbolIcon WindowNew24}" Click="Detach_Click" AutomationProperties.Name="Detach into its own window / dock back" ToolTip="Detach into its own window / dock back" />
                                <ui:Button x:Name="EditConnectionButton" Style="{StaticResource ToolButton}" Icon="{ui:SymbolIcon Edit24}" Click="EditSessionConnection_Click" AutomationProperties.Name="Edit connection" ToolTip="Edit connection" />
                            </StackPanel>
                        </Grid>

                        <Border Margin="0,6,0,0" Padding="0,6,0,0" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource ChromeStrokeBrush}"
                                Visibility="{Binding SelectedGroup.HasMultiple, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}">
                            <ListBox x:Name="Tabs" ItemsSource="{Binding SelectedGroup.Sessions}" SelectedItem="{Binding TabSelection}"
                                     ItemContainerStyle="{StaticResource SessionTabStyle}" Background="Transparent" BorderThickness="0"
                                     ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                     PreviewMouseUp="Tabs_PreviewMouseUp" PreviewMouseWheel="Tabs_PreviewMouseWheel"
                                     PreviewMouseRightButtonUp="Tabs_PreviewMouseRightButtonUp">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type r:SessionBase}">
                                        <Grid>
                                        <Border Height="2" CornerRadius="1" VerticalAlignment="Bottom" Margin="0,0,4,-5"
                                                Background="{Binding AccentBrush}"
                                                Visibility="{Binding IsSelected, Converter={StaticResource BoolToVisHidden}}" />
                                        <StackPanel Orientation="Horizontal">
                                            <StackPanel.ToolTip>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding StatusText}" />
                                                    <TextBlock Text="{Binding CredentialInfo}" Opacity="0.75" />
                                                </StackPanel>
                                            </StackPanel.ToolTip>
                                            <Ellipse Width="7" Height="7" Margin="0,0,8,0" VerticalAlignment="Center"
                                                     Fill="{Binding State, Converter={StaticResource StateBrush}}" />
                                            <ui:SymbolIcon Symbol="{Binding KindSymbol}" FontSize="14" Margin="0,0,6,0" />
                                            <TextBlock Text="{Binding KindLabel}" FontSize="13" VerticalAlignment="Center" />
                                            <Border Margin="6,0,0,0" Padding="5,0,5,1" CornerRadius="4" Background="#E5484D" VerticalAlignment="Center"
                                                    Visibility="{Binding IsRecording, Converter={StaticResource BoolToVis}}" ToolTip="Being recorded">
                                                <TextBlock Text="REC" FontSize="10" FontWeight="Bold" Foreground="White" />
                                            </Border>
                                            <ui:SymbolIcon Symbol="WindowNew24" FontSize="13" Margin="6,0,0,0" ToolTip="Detached window"
                                                           Visibility="{Binding IsDetached, Converter={StaticResource BoolToVis}}" />
                                            <Button Margin="6,0,0,0" Padding="3" MinWidth="0" Background="Transparent" BorderThickness="0"
                                                    Click="TabClose_Click" ToolTip="Close this tab" Cursor="Arrow">
                                                <ui:SymbolIcon Symbol="Dismiss24" FontSize="11" />
                                            </Button>
                                        </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>
                    </StackPanel>

                    <!-- Hosts of all docked sessions; only the selected one is visible -->
                    <Grid x:Name="SessionPanel" Grid.Row="1" Margin="8,2,8,8" />

                    <!-- Detached placeholder -->
                    <StackPanel x:Name="DetachedHint" Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
                        <ui:SymbolIcon Symbol="WindowNew24" FontSize="40" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                        <TextBlock Margin="0,10,0,14" Style="{StaticResource Caption}" FontSize="14" Text="This session runs in its own window." />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <ui:Button Content="Show window" Appearance="Primary" Click="ShowDetached_Click" Margin="0,0,8,0" />
                            <ui:Button Content="Dock back" Click="Detach_Click" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Welcome -->
                    <StackPanel Grid.Row="0" Grid.RowSpan="2" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="460"
                                Visibility="{Binding HasSessions, Converter={StaticResource InvBoolToVis}}">
                        <ui:SymbolIcon Symbol="Desktop24" FontSize="56" Foreground="{DynamicResource SystemAccentColorPrimaryBrush}" HorizontalAlignment="Center" />
                        <TextBlock Margin="0,14,0,6" FontSize="24" FontWeight="SemiBold" TextAlignment="Center" Text="RemoteHub" />
                        <TextBlock Style="{StaticResource Caption}" FontSize="14" TextAlignment="Center" TextWrapping="Wrap"
                                   Text="Double-click a connection to open it. Drag connections and folders to organize them, or drop .rdp files anywhere in this window to import them." />
                        <TextBlock x:Name="ShortcutHint" Margin="0,18,0,0" Style="{StaticResource Caption}" TextAlignment="Center" TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </Border>

            <GridSplitter x:Name="TransfersSplitter" Grid.Column="3" Width="5" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                          Background="Transparent" ResizeBehavior="PreviousAndNext" DragCompleted="TransfersSplitter_DragCompleted" Visibility="Collapsed" />

            <!-- ================= File transfers (right pane, collapsible like the navigation) ================= -->
            <Border x:Name="TransfersPane" Grid.Column="4" Margin="2,0,10,10" CornerRadius="10" Padding="10,10,8,8" Visibility="Collapsed"
                    Background="{DynamicResource SidebarBackgroundBrush}" BorderBrush="{DynamicResource ChromeStrokeBrush}" BorderThickness="1">
                <Grid>
                    <!-- Collapsed: slim rail -->
                    <StackPanel x:Name="TransfersRail" HorizontalAlignment="Center" Visibility="Collapsed">
                        <ui:Button Icon="{ui:SymbolIcon PanelRight24}" Click="ToggleTransfers_Click" Width="40" Height="36" Padding="0" Margin="0,0,0,10"
                                   AutomationProperties.Name="Show file transfers" ToolTip="Show file transfers" />
                        <ui:SymbolIcon Symbol="ArrowSwap24" FontSize="18" HorizontalAlignment="Center" ToolTip="{Binding TransferSummary}" />
                        <TextBlock Text="{Binding ActiveTransfers}" HorizontalAlignment="Center" Margin="0,4,0,0" Style="{StaticResource Caption}"
                                   ToolTip="Transfers running" Visibility="{Binding ActiveTransfers, Converter={StaticResource BoolToVis}}" />
                        <ui:Button Icon="{ui:SymbolIcon DismissCircle24}" Click="CancelAllTransfers_Click" Width="40" Height="32" Padding="0" Margin="0,8,0,0"
                                   AutomationProperties.Name="Cancel all transfers" ToolTip="Cancel all running and waiting transfers"
                                   Visibility="{Binding ActiveTransfers, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                    <!-- Expanded -->
                    <DockPanel x:Name="TransfersFull">
                        <DockPanel DockPanel.Dock="Top" LastChildFill="True">
                            <ui:Button DockPanel.Dock="Right" Icon="{ui:SymbolIcon PanelRightContract24}" Click="ToggleTransfers_Click" Margin="6,0,0,0"
                                       AutomationProperties.Name="Hide file transfers" ToolTip="Hide file transfers" />
                            <ui:Button DockPanel.Dock="Right" Icon="{ui:SymbolIcon Broom24}" Click="ClearTransfers_Click"
                                       AutomationProperties.Name="Clear finished transfers" ToolTip="Remove finished transfers from the list" />
                            <ui:Button DockPanel.Dock="Right" Icon="{ui:SymbolIcon DismissCircle24}" Click="CancelAllTransfers_Click" Margin="0,0,6,0"
                                       AutomationProperties.Name="Cancel all transfers" ToolTip="Cancel all running and waiting transfers"
                                       Visibility="{Binding ActiveTransfers, Converter={StaticResource BoolToVis}}" />
                            <StackPanel VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="ArrowSwap24" FontSize="16" Margin="0,0,8,0" />
                                    <TextBlock Text="File transfers" FontWeight="SemiBold" FontSize="14" />
                                </StackPanel>
                                <TextBlock Text="{Binding TransferSummary}" Style="{StaticResource Caption}" FontSize="11" Margin="0,2,0,0" />
                                <TextBlock Text="{Binding TransferSpeed}" Style="{StaticResource Caption}" FontSize="11" Margin="0,1,0,0"
                                           ToolTip="Current speed, and the average over the time files were actually moving (uploads count the original size, also when sent compressed)"
                                           Visibility="{Binding TransferSpeed, Converter={StaticResource BoolToVis}}" />
                            </StackPanel>
                        </DockPanel>
                        <ListBox ItemsSource="{Binding Transfers}" Margin="0,8,0,0" Background="Transparent" BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="0,4,0,6" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <ContentPresenter Margin="{TemplateBinding Padding}" />
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type rm:TransferItem}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="26" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <ui:SymbolIcon Symbol="{Binding State, Converter={StaticResource TransferSymbol}}" FontSize="14" Margin="0,1,8,0" VerticalAlignment="Top"
                                                       Foreground="{Binding State, Converter={StaticResource TransferBrush}}" />
                                        <TextBlock Grid.Column="1" Text="{Binding RelativePath}" TextTrimming="CharacterEllipsis" ToolTip="{Binding LocalPath}" />
                                        <Button Grid.Column="2" Grid.RowSpan="2" Padding="3" MinWidth="0" Background="Transparent" BorderThickness="0" Cursor="Arrow" VerticalAlignment="Top"
                                                Click="CancelTransfer_Click" ToolTip="Cancel" Visibility="{Binding IsActive, Converter={StaticResource BoolToVis}}">
                                            <ui:SymbolIcon Symbol="Dismiss24" FontSize="12" />
                                        </Button>
                                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Destination}" Style="{StaticResource Caption}" FontSize="11" ToolTip="{Binding Destination}" />
                                        <StackPanel Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,3,0,0">
                                            <ProgressBar Height="3" Minimum="0" Maximum="100" Value="{Binding Percent}"
                                                         Visibility="{Binding IsActive, Converter={StaticResource BoolToVis}}" Margin="0,0,0,3" />
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding SpeedText}" Style="{StaticResource Caption}" FontSize="11" Margin="8,0,0,0"
                                                           VerticalAlignment="Top" Visibility="{Binding SpeedText, Converter={StaticResource BoolToVis}}" />
                                                <TextBlock Text="{Binding StatusText}" Style="{StaticResource Caption}" FontSize="11" TextWrapping="Wrap" TextTrimming="None" />
                                            </DockPanel>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Grid>
            </Border>
        </Grid>
        </Grid>
    </Grid>
</ui:FluentWindow>
