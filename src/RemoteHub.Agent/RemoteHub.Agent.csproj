<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>RemoteHubAgent</AssemblyName>
    <ApplicationIcon>..\RemoteHub\Assets\app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RootNamespace>RemoteHub.Agent</RootNamespace>
    <Product>RemoteHub Agent</Product>
    <Authors>Grischa Ernst</Authors>
    <Company>Grischa Ernst</Company>
    <Copyright>© 2026 Grischa Ernst</Copyright>
    <Version>0.14.2</Version>
    <PlatformTarget>x64</PlatformTarget>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- Publish: one self-contained file, no runtime needed on the device -->
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>false</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>partial</TrimMode>
    <!-- Warnings come from unused framework parts (MVC); the agent itself is reflection-free – checked by "RemoteHubAgent.exe selftest". -->
    <SuppressTrimAnalysisWarnings>true</SuppressTrimAnalysisWarnings>
    <IsTransformWebConfigDisabled>true</IsTransformWebConfigDisabled>
    <StaticWebAssetsEnabled>false</StaticWebAssetsEnabled>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="RemoteHub.Tests" />
  </ItemGroup>

</Project>
