<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>RemoteHubAgent</AssemblyName>
    <ApplicationIcon>..\RemoteHub\Assets\app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RootNamespace>RemoteHub.Agent</RootNamespace>
    <Product>RemoteHub Agent</Product>
    <Authors>Grischa Ernst</Authors>
    <Company>Grischa Ernst</Company>
    <Copyright>© 2026 Grischa Ernst</Copyright>
    <Version>0.21.0</Version>
    <PlatformTarget>x64</PlatformTarget>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- Publish: one self-contained file, no runtime needed on the device (build-installer.ps1 publishes with
         self-contained on; here it stays off so the tests can reference the project) -->
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>false</SelfContained>
    <!-- Never extract native libraries: as LocalSystem they would land in SYSTEM's %TEMP% (C:\Windows\Temp on older
         Windows, where users can create folders) and be loaded from there. Any native library not linked into the exe
         stays next to it in Program Files; the MSI installs everything in the publish folder. -->
    <IncludeNativeLibrariesForSelfExtract>false</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>partial</TrimMode>
    <!-- Warnings come from unused framework parts (MVC); the agent itself is reflection-free â€“ checked by "RemoteHubAgent.exe selftest". -->
    <SuppressTrimAnalysisWarnings>true</SuppressTrimAnalysisWarnings>
    <IsTransformWebConfigDisabled>true</IsTransformWebConfigDisabled>
    <StaticWebAssetsEnabled>false</StaticWebAssetsEnabled>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="RemoteHub.Tests" />
  </ItemGroup>

  <!-- The agent's license (AGPL-3.0) and the notices of what it ships (the virtual display driver), next to the exe. -->
  <ItemGroup>
    <None Include="..\..\LICENSE" Link="LICENSE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <None Include="..\..\THIRD-PARTY-NOTICES.md" Link="THIRD-PARTY-NOTICES.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
  </ItemGroup>

  <!-- msquic.dll is marked DropFromSingleFile in the runtime pack, so a single-file publish left it out and QUIC – the
       direct path through the RemoteHub Broker – wasn't supported on any device. It goes next to the exe like the other
       native files ("RemoteHubAgent.exe selftest" checks it). -->
  <Target Name="PublishMsQuic" AfterTargets="ComputeResolvedFilesToPublishList" Condition="'$(SelfContained)' == 'true'">
    <ItemGroup>
      <ResolvedFileToPublish Include="@(RuntimePackAsset)" Condition="'%(Filename)%(Extension)' == 'msquic.dll'"
                             RelativePath="msquic.dll" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    </ItemGroup>
  </Target>

  <!-- Optional virtual monitor for devices without one (third-party, MIT, signed â€“ see third-party\...\README.md).
       Installed next to the exe in "VirtualDisplay"; the agent checks the files' hashes before it installs the driver. -->
  <ItemGroup>
    <None Include="..\..\third-party\VirtualDisplayDriver\24.12.24\*" Exclude="..\..\third-party\VirtualDisplayDriver\24.12.24\README.md"
          Link="VirtualDisplay\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest"
          ExcludeFromSingleFile="true" />
  </ItemGroup>

</Project>
