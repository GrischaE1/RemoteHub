<?xml version="1.0" encoding="utf-8"?>
<!--
  Per-machine MSI for the RemoteHub Agent (the same MSI for every device; the device identity comes from the
  per-device enrollment file).

  Install:   msiexec /i RemoteHub-Agent-<ver>-x64.msi ENROLLMENT="C:\path\device.rhagent" [VIRTUALDISPLAY=0|1] [AUTOSIGNIN=0|1] /qn
             (AUTOSIGNIN only in MSIs built with the credential provider, build-installer.ps1 -CredentialProvider)
             Without ENROLLMENT the .rhagent file next to the MSI is used. An already enrolled agent can be updated
             without any enrollment file.
  Uninstall: msiexec /x RemoteHub-Agent-<ver>-x64.msi /qn   (removes firewall rule, certificate and configuration)
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">
  <Package Name="RemoteHub Agent"
           Manufacturer="Grischa Ernst"
           Version="$(var.Version)"
           UpgradeCode="{71CF9765-2EB2-4B8F-B884-6207058C99F8}"
           Scope="perMachine"
           Compressed="yes">

    <!-- Same version allowed too: a rebuilt agent replaces the installed one (test builds, re-deploys). -->
    <MajorUpgrade AllowSameVersionUpgrades="yes" DowngradeErrorMessage="A newer version of the RemoteHub Agent is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <Icon Id="AgentIcon.ico" SourceFile="$(var.IconPath)" />
    <Property Id="ARPPRODUCTICON" Value="AgentIcon.ico" />
    <Property Id="ARPNOMODIFY" Value="1" />
    <Property Id="ENROLLMENT" Secure="yes" />
    <!-- Virtual monitor for devices without one: 1 install, 0 don't (removes it), empty = the device keeps its setting (default on). -->
    <Property Id="VIRTUALDISPLAY" Secure="yes" />
<?ifdef CredentialProviderDll?>
    <!-- Automatic sign-in (docs/credential-provider-design.md §8.4): 1 installs and registers the credential provider,
         0 removes it, empty = a first install installs it, an update keeps what is installed (MSI carries the
         feature's state over to the new version). An installed agent adds or removes it later with
         ADDLOCAL / REMOVE=CredentialProvider. -->
    <Property Id="AUTOSIGNIN" Secure="yes" />
<?endif?>

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="RemoteHub Agent" />
    </StandardDirectory>

    <Feature Id="Main" Title="RemoteHub Agent">
      <ComponentRef Id="AgentService" />
      <!-- Native libraries the single-file exe doesn't contain (it never extracts them to a temp folder). -->
      <Files Directory="INSTALLFOLDER" Include="$(var.AgentPublishDir)\**">
        <Exclude Files="$(var.AgentPublishDir)\RemoteHubAgent.exe" />
      </Files>
    </Feature>
<?ifdef CredentialProviderDll?>
    <!-- Installed by default, like every feature (admins turn automatic sign-in off by policy: NoUserBehavior, or
         Windows' ExcludedCredentialProviders); AUTOSIGNIN=0 rules it out even when an update would carry it over. -->
    <Feature Id="CredentialProvider" Title="Automatic sign-in (credential provider)" Level="1" AllowAbsent="yes">
      <ComponentRef Id="CredentialProvider" />
      <Level Value="0" Condition="AUTOSIGNIN = &quot;0&quot;" />
    </Feature>
<?endif?>

    <!-- Enrollment: deferred, as LocalSystem, after the files are in place and before the service starts.
         It also sets "Automatic (Delayed Start)" – MSI's own ServiceConfig table is unreliable for that. -->
    <!-- No ENROLLMENT given: the agent looks for the .rhagent file in the MSI's folder. -->
    <SetProperty Id="ENROLLMENT" Value="[OriginalDatabase]" Before="SetAgentEnroll" Sequence="execute" Condition="NOT ENROLLMENT" />
    <!-- auto-sign-in=[AUTOSIGNIN]: 1 allows automatic sign-in for the allowed groups in agent.json, 0 turns it off there,
         empty leaves agent.json as it is (a first install: allowed, the agent's default). A policy IT has set
         (NoUserBehavior, right AutoSignIn) wins either way. -->
    <SetProperty Id="AgentEnroll" Value="&quot;[#AgentExe]&quot; enroll &quot;[ENROLLMENT]&quot; &quot;virtual-display=[VIRTUALDISPLAY]&quot; &quot;auto-sign-in=[AUTOSIGNIN]&quot;" Before="AgentEnroll" Sequence="execute" />
    <CustomAction Id="AgentEnroll" BinaryRef="Wix4UtilCA_X64" DllEntry="WixQuietExec64"
                  Execute="deferred" Impersonate="no" Return="check" />

    <!-- A first install that fails after enrolling: remove the firewall rule, certificate and configuration again.
         Only for a first install – a failed upgrade must keep the enrolled agent that was there before. -->
    <SetProperty Id="AgentEnrollRollback" Value="&quot;[#AgentExe]&quot; cleanup" Before="AgentEnrollRollback" Sequence="execute" />
    <CustomAction Id="AgentEnrollRollback" BinaryRef="Wix4UtilCA_X64" DllEntry="WixQuietExec64"
                  Execute="rollback" Impersonate="no" Return="ignore" />

    <SetProperty Id="AgentCleanup" Value="&quot;[#AgentExe]&quot; cleanup"
                 Before="AgentCleanup" Sequence="execute" Condition="REMOVE~=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
    <CustomAction Id="AgentCleanup" BinaryRef="Wix4UtilCA_X64" DllEntry="WixQuietExec64"
                  Execute="deferred" Impersonate="no" Return="ignore" />

    <InstallExecuteSequence>
      <Custom Action="AgentEnrollRollback" Before="AgentEnroll" Condition="NOT Installed AND NOT WIX_UPGRADE_DETECTED AND NOT (REMOVE~=&quot;ALL&quot;)" />
      <!-- Only when this product is installed (first install or upgrade) – not when an installed agent only adds or
           removes a feature (credential provider), which leaves the service and its enrollment alone. -->
      <Custom Action="AgentEnroll" Before="StartServices" Condition="NOT Installed" />
      <Custom Action="AgentCleanup" After="StopServices" Condition="REMOVE~=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
    </InstallExecuteSequence>
  </Package>

  <Fragment>
    <Component Id="AgentService" Directory="INSTALLFOLDER">
      <File Id="AgentExe" Source="$(var.AgentPublishDir)\RemoteHubAgent.exe" KeyPath="yes" />
      <ServiceInstall Id="AgentServiceInstall"
                      Name="RemoteHubAgent"
                      DisplayName="RemoteHub Agent"
                      Description="Gives RemoteHub a PowerShell session and the remote desktop on this device over TLS (port and allowed accounts: %ProgramData%\RemoteHub\Agent\agent.json)."
                      Type="ownProcess"
                      Start="auto"
                      ErrorControl="normal"
                      Account="LocalSystem"
                      Vital="yes">
        <util:ServiceConfig FirstFailureActionType="restart" SecondFailureActionType="restart" ThirdFailureActionType="restart"
                            RestartServiceDelayInSeconds="10" ResetPeriodInDays="1" />
      </ServiceInstall>
      <ServiceControl Id="AgentServiceControl" Name="RemoteHubAgent" Start="install" Stop="both" Remove="uninstall" Wait="yes" />
      <!-- Audit entries in the Application log (source "RemoteHub Agent"); the text is shown through .NET Framework's
           message file, which is part of Windows. Removed with the agent. -->
      <RegistryKey Root="HKLM" Key="SYSTEM\CurrentControlSet\Services\EventLog\Application\RemoteHub Agent" ForceDeleteOnUninstall="yes">
        <RegistryValue Name="EventMessageFile" Type="expandable" Value="%SystemRoot%\Microsoft.NET\Framework64\v4.0.30319\EventLogMessages.dll" />
      </RegistryKey>
    </Component>
  </Fragment>
<?ifdef CredentialProviderDll?>

  <!-- The credential provider, in its own feature (see above). Registered by the MSI (never by the service at runtime,
       §8.5), with a fixed CLSID that never changes, so IT can exclude it (ExcludedCredentialProviders). -->
  <Fragment>
    <Component Id="CredentialProvider" Directory="INSTALLFOLDER" Bitness="always64">
      <File Id="CredentialProviderDll" Source="$(var.CredentialProviderDll)" Name="RemoteHubCredentialProvider.dll" KeyPath="yes" />
      <RegistryKey Root="HKLM" Key="SOFTWARE\Microsoft\Windows\CurrentVersion\Authentication\Credential Providers\{718FFFD2-6671-4FA4-9FA8-86D1CD4D84C3}" ForceDeleteOnUninstall="yes">
        <RegistryValue Type="string" Value="RemoteHub Agent" />
      </RegistryKey>
      <RegistryKey Root="HKLM" Key="SOFTWARE\Classes\CLSID\{718FFFD2-6671-4FA4-9FA8-86D1CD4D84C3}" ForceDeleteOnUninstall="yes">
        <RegistryValue Type="string" Value="RemoteHub Agent" />
        <RegistryKey Key="InprocServer32">
          <RegistryValue Type="string" Value="[#CredentialProviderDll]" />
          <RegistryValue Name="ThreadingModel" Type="string" Value="Apartment" />
        </RegistryKey>
      </RegistryKey>
    </Component>
  </Fragment>
<?endif?>
</Wix>
